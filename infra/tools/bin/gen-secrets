#!/bin/bash
# Prints fresh random values for every secret in .env.
# It never writes .env itself: copy the lines you need into .env by hand.
set -euo pipefail

hex() { openssl rand -hex "$1"; }

cat <<EOF
# ---- generated $(date '+%Y-%m-%d %H:%M %Z') - paste into .env ----
POSTGRES_SUPERUSER_PASSWORD=$(hex 24)
N8N_DB_PASSWORD=$(hex 24)
OFFICE_MIGRATOR_PASSWORD=$(hex 24)
OFFICE_APP_PASSWORD=$(hex 24)
OFFICE_READONLY_PASSWORD=$(hex 24)
OFFICE_API_PASSWORD=$(hex 24)
REDIS_PASSWORD=$(hex 24)
GARAGE_RPC_SECRET=$(hex 32)
GARAGE_ADMIN_TOKEN=$(hex 32)
S3_N8N_ACCESS_KEY_ID=GK$(hex 12)
S3_N8N_SECRET_ACCESS_KEY=$(hex 32)
S3_BACKUP_ACCESS_KEY_ID=GK$(hex 12)
S3_BACKUP_SECRET_ACCESS_KEY=$(hex 32)
S3_API_ACCESS_KEY_ID=GK$(hex 12)
S3_API_SECRET_ACCESS_KEY=$(hex 32)
N8N_ENCRYPTION_KEY=$(hex 32)
HAZEM_API_TOKEN=$(hex 32)
N8N_INTERNAL_SEND_TOKEN=$(hex 32)
PANEL_SECRET_KEY=$(hex 32)
CHATWOOT_SECRET_KEY_BASE=$(hex 64)
CHATWOOT_DB_PASSWORD=$(hex 24)
CHATWOOT_REDIS_PASSWORD=$(hex 24)
CHATWOOT_PLATFORM_TOKEN=$(hex 24)
CHATWOOT_BOT_TOKEN=$(hex 24)
CHATWOOT_WEBHOOK_TOKEN=$(hex 32)
# ---- keep a safe copy of N8N_ENCRYPTION_KEY outside this machine ----
EOF
