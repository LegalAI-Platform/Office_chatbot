#!/bin/bash
# Dumps the office and n8n databases, and Chatwoot's (TASK 07b: a second copy of client
# messages, T-24), in pg_dump custom format, compressed, and uploads them to
# s3://office-backups/postgres/<db>/<db>_<YYYYmmdd-HHMMSS>.dump
# Restoring Chatwoot's is not in the restore command yet (TASK 13).
# Timestamps use Africa/Cairo. Objects expire after 30 days (bucket lifecycle).
set -euo pipefail
source /usr/local/bin/_lib

ts="$(date '+%Y%m%d-%H%M%S')"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

for db in office n8n; do
  file="${db}_${ts}.dump"
  log "Dumping $db ..."
  PGPASSWORD="$POSTGRES_SUPERUSER_PASSWORD" pg_dump -h postgres -U "$POSTGRES_SUPERUSER" \
    -d "$db" -Fc -Z 6 --no-password -f "$work/$file"
  size="$(du -h "$work/$file" | cut -f1)"
  s3_as backup s3 cp --only-show-errors "$work/$file" "s3://$BUCKET_BACKUPS/postgres/$db/$file"
  echo "s3://$BUCKET_BACKUPS/postgres/$db/$file  ($size)"
done

file="chatwoot_${ts}.dump"
log "Dumping chatwoot ..."
PGPASSWORD="$CHATWOOT_DB_PASSWORD" pg_dump -h chatwoot-db -U chatwoot -d chatwoot -Fc -Z 6 --no-password -f "$work/$file"
size="$(du -h "$work/$file" | cut -f1)"
s3_as backup s3 cp --only-show-errors "$work/$file" "s3://$BUCKET_BACKUPS/postgres/chatwoot/$file"
echo "s3://$BUCKET_BACKUPS/postgres/chatwoot/$file  ($size)"

log "Backup complete."
