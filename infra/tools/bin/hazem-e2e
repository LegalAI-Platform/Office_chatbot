#!/bin/bash
# Steps of the end-to-end test n8n <-> .NET API (DECISIONS v1.3 + TASK 03), driven by
# scripts/*/hazem-e2e. Each step is one call: hazem-e2e <step>. Dummy numbers 20100000006x only.
# Meta and OpenAI are replaced by meta-stub (profile tests); whatsapp.dry_run records sends
# without Meta. Every setting the test changes is backed up first and restored by "cleanup".
set -uo pipefail
source /usr/local/bin/_lib

A=201000000061   # one message -> echo; replay; API -> n8n send
B=201000000062   # writes while the API is down
C=201000000063   # two texts and a photo within 8 s -> one turn
D=201000000064   # PDF, voice note, too large, wrong sha256, forbidden type
E=201000000065   # turn left processing while n8n restarts
F=201000000066   # TASK 04: booking request -> name -> offer; legal question; AI down
G=201000000067   # TASK 04: a photo without words never reaches the AI
ALL="'$A','$B','$C','$D','$E','$F','$G'"
STUB=http://meta-stub:8080

passed=0; failed=0
assert_eq() {  # assert_eq "description" actual expected
  if [[ "$2" == "$3" ]]; then echo "PASS  $1"; passed=$((passed+1))
  else echo "FAIL  $1 (got '$2', expected '$3')"; failed=$((failed+1)); fi
}
q() { psql_super office -c "$1"; }
# n8n's every-minute schedule may be handling the same rows right now, so states are polled
# (up to 30 s) instead of read once.
wait_eq() {  # wait_eq "description" "SQL" expected
  local got=""
  for _ in $(seq 1 30); do
    got="$(q "$2")"
    [[ "$got" == "$3" ]] && break
    sleep 1
  done
  assert_eq "$1" "$got" "$3"
}
event() {  # event WA_ID WAMID TYPE JSON_FOR_TYPE: a Meta webhook event as the WhatsApp Trigger emits it
  jq -nc --arg wa "$1" --arg id "$2" --arg type "$3" --argjson b "$4" --arg ts "$(date +%s)" '{
    field: "messages", messaging_product: "whatsapp",
    metadata: {display_phone_number: "15550000000", phone_number_id: "100000000000001"},
    contacts: [{profile: {name: "E2E"}, wa_id: $wa}],
    messages: [{from: $wa, id: $id, timestamp: $ts, type: $type} + {($type): $b}]}'
}
inject() {  # inject WA_ID WAMID TYPE JSON_FOR_TYPE [SECONDS_AGO]: through app.wa_process_event, as n8n does
  psql_as office_app "$OFFICE_APP_PASSWORD" office -v ev="$(event "$1" "$2" "$3" "$4")" \
    <<<"SELECT app.wa_process_event(:'ev'::jsonb);" >/dev/null
  # Older messages close their turn without waiting for the 8-second quiet period.
  [[ -n "${5:-}" ]] && q "UPDATE app.wa_inbound_messages SET received_at = now() - interval '$5 seconds' WHERE wamid = '$2'" >/dev/null
  return 0
}
text() { jq -nc --arg t "$1" '{body: $t}'; }
turn_of() { echo "(SELECT turn_id FROM app.wa_inbound_messages WHERE wamid = '$1')"; }
backup_set() {  # backup_set KEY VALUE: remember the original value once, then change it
  q "INSERT INTO app.settings (key, value, description)
       SELECT 'e2e.backup.' || key, value, 'hazem-e2e: original value, restored by cleanup'
         FROM app.settings WHERE key = '$1'
     ON CONFLICT (key) DO NOTHING;
     UPDATE app.settings SET value = '$2', updated_by = 'hazem-e2e' WHERE key = '$1';" >/dev/null
}
hazem_backup_set() {  # same as backup_set, for hazem.settings (the API's settings)
  q "INSERT INTO hazem.settings (key, value, description)
       SELECT 'e2e.backup.' || key, value, 'hazem-e2e: original value, restored by cleanup'
         FROM hazem.settings WHERE key = '$1'
     ON CONFLICT (key) DO NOTHING;
     UPDATE hazem.settings SET value = '$2', updated_by = 'hazem-e2e' WHERE key = '$1';" >/dev/null
}
sent_texts() {  # sent_texts WA_ID: every text n8n sent to that number, in order, joined by " || "
  q "SELECT string_agg(request_payload->'text'->>'body', ' || ' ORDER BY created_at, idempotency_key) FROM app.wa_outbound_messages WHERE wa_id = '$1'"
}
WELCOME="أهلًا بحضرتك في مكتب الأستاذ سعد فتحي سعد للمحاماة، معاك حازم. ممكن اسم حضرتك رباعي؟"
OFFER="الأستاذ يقدر يشوف الموضوع مع حضرتك في استشارة: بالتليفون بـ500 أو في المكتب بـ1,000."
LEGAL="الأستاذ هو اللي هيجاوب حضرتك على ده في الاستشارة."
stub_log() { curl -s "$STUB/_log"; }
finish() { echo "Result: $passed passed, $failed failed."; [[ $failed -eq 0 ]]; }

case "${1:-}" in
  cleanup)
    # Files this test stored in S3 (dummy numbers only).
    while IFS='|' read -r bucket key; do
      [[ -n "$bucket" ]] && s3_as n8n s3 rm "s3://$bucket/$key" >/dev/null 2>&1
    done < <(q "SELECT w.bucket || '|' || w.object_key FROM app.wa_media w JOIN app.wa_inbound_messages m ON m.id = w.inbound_message_id
                 WHERE m.wa_id IN ($ALL) AND w.object_key IS NOT NULL")
    q "
      DELETE FROM hazem.turn_replies WHERE turn_id IN (SELECT turn_id FROM hazem.turns WHERE wa_id IN ($ALL));
      DELETE FROM hazem.classifications WHERE turn_id IN (SELECT turn_id FROM hazem.turns WHERE wa_id IN ($ALL));
      DELETE FROM hazem.pending_tasks WHERE person_id IN (SELECT id FROM hazem.persons WHERE wa_id IN ($ALL));
      DELETE FROM hazem.intakes WHERE person_id IN (SELECT id FROM hazem.persons WHERE wa_id IN ($ALL));
      DELETE FROM hazem.conversations WHERE person_id IN (SELECT id FROM hazem.persons WHERE wa_id IN ($ALL));
      DELETE FROM hazem.persons WHERE wa_id IN ($ALL);
      UPDATE hazem.settings s SET value = b.value, updated_by = 'hazem-e2e'
        FROM hazem.settings b WHERE b.key = 'e2e.backup.' || s.key;
      DELETE FROM hazem.settings WHERE key LIKE 'e2e.backup.%';
      UPDATE hazem.settings SET value = 'hazem', updated_by = 'hazem-e2e' WHERE key = 'responder';
      UPDATE hazem.settings SET value = 'false', updated_by = 'hazem-e2e' WHERE key = 'ai.stub_enabled';
      UPDATE hazem.settings SET value = '', updated_by = 'hazem-e2e' WHERE key = 'ai.stub_base_url';
      DELETE FROM hazem.send_results WHERE idempotency_key IN
        (SELECT idempotency_key FROM app.wa_outbound_messages WHERE wa_id IN ($ALL));
      DELETE FROM hazem.send_results WHERE idempotency_key LIKE 'e2e:%';
      DELETE FROM app.wa_outbound_messages WHERE wa_id IN ($ALL);
      DELETE FROM app.wa_inbound_messages WHERE wa_id IN ($ALL);
      DELETE FROM app.wa_turns WHERE wa_id IN ($ALL);
      DELETE FROM app.wa_contact_windows WHERE wa_id IN ($ALL);
      DELETE FROM app.wa_webhook_events WHERE payload->'contacts'->0->>'wa_id' IN ($ALL);
      DELETE FROM hazem.turns WHERE wa_id IN ($ALL);
      UPDATE app.settings s SET value = b.value, updated_by = 'hazem-e2e'
        FROM app.settings b WHERE b.key = 'e2e.backup.' || s.key;
      DELETE FROM app.settings WHERE key LIKE 'e2e.backup.%';
      UPDATE app.settings SET value = 'false', updated_by = 'hazem-e2e' WHERE key = 'whatsapp.dry_run';
      UPDATE hazem.settings SET value = 'false', updated_by = 'hazem-e2e' WHERE key = 'echo.enabled';
      UPDATE hazem.settings SET value = '', updated_by = 'hazem-e2e' WHERE key = 'echo.recipients';" >/dev/null
    echo "cleaned: dummy rows and files deleted, settings restored, dry run, echo and the AI stub switched off, responder hazem"
    ;;

  setup)
    "$0" cleanup >/dev/null
    backup_set whatsapp.dry_run true
    backup_set whatsapp.graph_base_url "$STUB"
    backup_set ai.openai_base_url "$STUB/v1"
    if [[ -z "$(q "SELECT value FROM app.settings WHERE key = 'whatsapp.graph_api_version'")" ]]; then
      backup_set whatsapp.graph_api_version v26.0
    fi
    # Steps 1-7 are the TASK 02/03 loop: they still run with the test echo (TASK 04: responder).
    hazem_backup_set responder echo
    q "
      UPDATE hazem.settings SET value = 'true', updated_by = 'hazem-e2e' WHERE key = 'echo.enabled';
      UPDATE hazem.settings SET value = '$A,$B,$C,$D,$E', updated_by = 'hazem-e2e' WHERE key = 'echo.recipients';" >/dev/null
    curl -s -X POST "$STUB/_log/reset" >/dev/null || die "meta-stub is not running"
    inject "$A" wamid.E2E-1 text "$(text "مرحبا من اختبار e2e")" 10
    echo "setup: stub, dry run and echo on; wamid.E2E-1 waiting"
    ;;

  remove-test-credentials)
    # Only the fixed test ids AND names created by n8n/scripts/e2e-credentials.sh add.
    psql_super n8n -c "
      DELETE FROM shared_credentials WHERE \"credentialsId\" IN
        (SELECT id FROM credentials_entity WHERE (id, name) IN (('TestMetaToken001', 'meta-whatsapp-token'), ('TestOpenAiKey001', 'openai-transcription')));
      DELETE FROM credentials_entity WHERE (id, name) IN (('TestMetaToken001', 'meta-whatsapp-token'), ('TestOpenAiKey001', 'openai-transcription'));" >/dev/null
    echo "test credentials removed: $(psql_super n8n -c "SELECT count(*) FROM credentials_entity WHERE id IN ('TestMetaToken001', 'TestOpenAiKey001')") left"
    ;;

  check-loop)
    T="$(turn_of wamid.E2E-1)"
    wait_eq "inbound message handed to the API and finished" \
      "SELECT processing_status FROM app.wa_inbound_messages WHERE wamid = 'wamid.E2E-1'" "processed"
    wait_eq "API stored the turn and answered with the echo" \
      "SELECT status || '/' || responder || '/' || jsonb_array_length(actions) FROM hazem.turns WHERE turn_id = $T" "processed/echo/1"
    wait_eq "n8n sent the API's action once (dry run, never Meta)" \
      "SELECT status || '/' || attempts || '/' || (wamid LIKE 'wamid.DRYRUN-%') || '/' || requested_by FROM app.wa_outbound_messages WHERE idempotency_key = 'hazem:' || $T || ':0'" "sent/1/true/hazem-api"
    wait_eq "the reply quotes the client's message" \
      "SELECT request_payload->'context'->>'message_id' FROM app.wa_outbound_messages WHERE idempotency_key = 'hazem:' || $T || ':0'" "wamid.E2E-1"
    wait_eq "n8n reported the send result back to the API" \
      "SELECT ok || '/' || reported_by || '/' || status FROM hazem.send_results WHERE idempotency_key = 'hazem:' || $T || ':0'" "true/n8n/sent"
    finish
    ;;

  replay)
    # As if n8n had stopped half-way: the turn is handed over again (same turn_id).
    q "UPDATE app.wa_turns SET status = 'pending' WHERE turn_id = $(turn_of wamid.E2E-1);
       UPDATE app.wa_inbound_messages SET processing_status = 'pending', processed_at = NULL WHERE wamid = 'wamid.E2E-1';" >/dev/null
    echo "replay: the turn of wamid.E2E-1 is pending again"
    ;;

  check-replay)
    T="$(turn_of wamid.E2E-1)"
    wait_eq "replayed turn finished again, with the same turn_id (attempt 2)" \
      "SELECT m.processing_status || '/' || t.attempts FROM app.wa_inbound_messages m JOIN app.wa_turns t USING (turn_id) WHERE m.wamid = 'wamid.E2E-1'" "processed/2"
    wait_eq "replay: still one turn in the API" \
      "SELECT count(*) FROM hazem.turns WHERE turn_id = $T" "1"
    wait_eq "replay: the client still got exactly one reply (1 row, 1 attempt)" \
      "SELECT count(*) || '/' || max(attempts) FROM app.wa_outbound_messages WHERE wa_id = '$A'" "1/1"
    finish
    ;;

  inject-b)
    inject "$B" wamid.E2E-2 text "$(text "رسالة والـ API واقف")" 10
    echo "wamid.E2E-2 waiting"
    ;;

  check-api-down)
    wait_eq "API down: the message waits as pending (not lost)" \
      "SELECT processing_status || '/' || (last_error->>'code') FROM app.wa_inbound_messages WHERE wamid = 'wamid.E2E-2'" "pending/API_UNAVAILABLE"
    wait_eq "API down: the turn is given back (pending) and nothing was sent" \
      "SELECT (SELECT status FROM app.wa_turns WHERE turn_id = $(turn_of wamid.E2E-2)) || '/' || (SELECT count(*) FROM app.wa_outbound_messages WHERE wa_id = '$B')" "pending/0"
    finish
    ;;

  check-recovered)
    wait_eq "API back: the waiting message is handled" \
      "SELECT processing_status FROM app.wa_inbound_messages WHERE wamid = 'wamid.E2E-2'" "processed"
    wait_eq "API back: same turn_id, its reply is sent once" \
      "SELECT (SELECT count(*) FROM app.wa_turns WHERE wa_id = '$B') || '/' || (SELECT status || ':' || attempts FROM app.wa_outbound_messages WHERE idempotency_key = 'hazem:' || $(turn_of wamid.E2E-2) || ':0')" "1/sent:1"
    finish
    ;;

  check-api-send)
    wait_eq "API -> n8n: the API's own send went through n8n's rules (dry run)" \
      "SELECT count(*) FROM app.wa_outbound_messages WHERE wa_id = '$A' AND requested_by = 'hazem-api:cli send-test' AND status = 'sent' AND wamid LIKE 'wamid.DRYRUN-%'" "1"
    wait_eq "API -> n8n: the API recorded the result" \
      "SELECT count(*) FROM hazem.send_results WHERE idempotency_key LIKE 'cli-send-test:%' AND reported_by = 'api' AND ok AND updated_at > now() - interval '5 minutes'" "1"
    finish
    ;;

  check-auth)
    code="$(curl -s -o /dev/null -w '%{http_code}' -X POST http://n8n:5678/webhook/hazem-internal-send \
      -H 'Content-Type: application/json' \
      -d "{\"type\":\"send_text\",\"wa_id\":\"$A\",\"text\":\"x\",\"idempotency_key\":\"e2e:noauth\"}")"
    assert_eq "n8n internal send without the token is refused" "$code" "403"
    code="$(curl -s -o /dev/null -w '%{http_code}' -X POST http://n8n:5678/webhook/hazem-internal-send \
      -H 'Content-Type: application/json' -H "X-Hazem-Token: $HAZEM_API_TOKEN" \
      -d "{\"type\":\"send_text\",\"wa_id\":\"$A\",\"text\":\"x\",\"idempotency_key\":\"e2e:noauth\"}")"
    assert_eq "n8n internal send with the other direction's token is refused" "$code" "403"
    wait_eq "refused requests sent nothing" \
      "SELECT count(*) FROM app.wa_outbound_messages WHERE idempotency_key = 'e2e:noauth'" "0"
    code="$(curl -s -o /dev/null -w '%{http_code}' -X POST http://api:8080/api/hazem/turns \
      -H 'Content-Type: application/json' -H "X-Hazem-Token: $N8N_INTERNAL_SEND_TOKEN" -d '{}')"
    assert_eq "API refuses the other direction's token" "$code" "401"
    finish
    ;;

  # ---------------------------------------------------------------- TASK 03
  group-c)
    # Real time on purpose: three messages within 8 s must become one turn.
    inject "$C" wamid.E2E-C1 text "$(text "السلام عليكم")"
    inject "$C" wamid.E2E-C2 text "$(text "دي صورة البطاقة")"
    inject "$C" wamid.E2E-C3 image '{"id":"STUB-IMG","mime_type":"image/jpeg","caption":"البطاقة"}'
    echo "two texts and a photo from $C"
    ;;

  check-group)
    T="$(turn_of wamid.E2E-C1)"
    wait_eq "two texts and a photo within 8 s -> ONE turn with the 3 messages" \
      "SELECT count(DISTINCT turn_id) || '/' || count(*) FILTER (WHERE processing_status = 'processed') FROM app.wa_inbound_messages WHERE wa_id = '$C'" "1/3"
    wait_eq "the API received one turn with 3 messages and answered once" \
      "SELECT (SELECT jsonb_array_length(messages) FROM hazem.turns WHERE turn_id = $T) || '/' || (SELECT count(*) FROM app.wa_outbound_messages WHERE wa_id = '$C')" "3/1"
    wait_eq "the single reply is about the photo" \
      "SELECT request_payload->'text'->>'body' FROM app.wa_outbound_messages WHERE wa_id = '$C'" "تم استلام الصورة (اختبار) ✅"
    expected_sha="$(curl -s -H 'Authorization: Bearer probe' "$STUB/v26.0/STUB-IMG" | jq -r .sha256)"
    wait_eq "the photo is stored in office-sensitive under wa/yyyy/mm/<id>.jpg with the right sha256" \
      "SELECT status || '/' || bucket || '/' || (object_key ~ '^wa/[0-9]{4}/[0-9]{2}/[0-9a-f-]{36}\.jpg$') || '/' || (sha256 = '$expected_sha') FROM app.wa_media WHERE meta_media_id = 'STUB-IMG' AND inbound_message_id = (SELECT id FROM app.wa_inbound_messages WHERE wamid = 'wamid.E2E-C3')" "stored/office-sensitive/true/true"
    key="$(q "SELECT object_key FROM app.wa_media WHERE inbound_message_id = (SELECT id FROM app.wa_inbound_messages WHERE wamid = 'wamid.E2E-C3')")"
    assert_eq "the file really is in the bucket" \
      "$(s3_as n8n s3api head-object --bucket office-sensitive --key "$key" 2>/dev/null | jq -r '.ContentLength > 0')" "true"
    assert_eq "the key holds no phone number and no wamid" \
      "$([[ "$key" != *"$C"* && "$key" != *wamid* ]] && echo clean || echo leaked)" "clean"
    finish
    ;;

  media-d)
    inject "$D" wamid.E2E-D1 document '{"id":"STUB-PDF","mime_type":"application/pdf","filename":"عقد إيجار.pdf"}'
    inject "$D" wamid.E2E-D2 audio '{"id":"STUB-OGG","mime_type":"audio/ogg; codecs=opus","voice":true}'
    inject "$D" wamid.E2E-D3 document '{"id":"STUB-BIG","mime_type":"application/pdf","filename":"كبير.pdf"}'
    inject "$D" wamid.E2E-D4 image '{"id":"STUB-BADSHA","mime_type":"image/jpeg"}'
    inject "$D" wamid.E2E-D5 document '{"id":"STUB-EXE","mime_type":"application/x-msdownload","filename":"a.exe"}'
    echo "PDF, voice, too large, wrong sha256 and forbidden type from $D"
    ;;

  check-media)
    T="$(turn_of wamid.E2E-D1)"
    st() { echo "SELECT w.status || COALESCE('/' || w.bucket, '') FROM app.wa_media w JOIN app.wa_inbound_messages m ON m.id = w.inbound_message_id WHERE m.wamid = '$1'"; }
    wait_eq "the five files went to the API as one turn" \
      "SELECT (SELECT count(DISTINCT turn_id) FROM app.wa_inbound_messages WHERE wa_id = '$D') || '/' || COALESCE((SELECT jsonb_array_length(messages) FROM hazem.turns WHERE turn_id = $T), 0)" "1/5"
    wait_eq "PDF -> stored in office-sensitive" "$(st wamid.E2E-D1)" "stored/office-sensitive"
    wait_eq "voice note -> stored in office-media" "$(st wamid.E2E-D2)" "stored/office-media"
    wait_eq "voice note -> transcript from the stub, and it reached the API" \
      "SELECT (SELECT transcript_status FROM app.wa_media w JOIN app.wa_inbound_messages m ON m.id = w.inbound_message_id WHERE m.wamid = 'wamid.E2E-D2') || '/' || (SELECT x->'transcript'->>'text' FROM hazem.turns t, jsonb_array_elements(t.messages) x WHERE t.turn_id = $T AND x->>'wamid' = 'wamid.E2E-D2')" "done/عايز أحجز ميعاد استشارة يوم الخميس الساعة خمسة"
    wait_eq "the reply quotes the transcript" \
      "SELECT request_payload->'text'->>'body' FROM app.wa_outbound_messages WHERE wa_id = '$D'" "تم استلام رسالتك الصوتية (اختبار): عايز أحجز ميعاد استشارة يوم الخميس الساعة خمسة"
    wait_eq "70 MB file -> too_large, never downloaded, still in the turn" \
      "SELECT ($(st wamid.E2E-D3)) || '/' || (SELECT x->'media'->>'status' FROM hazem.turns t, jsonb_array_elements(t.messages) x WHERE t.turn_id = $T AND x->>'wamid' = 'wamid.E2E-D3')" "too_large/too_large"
    wait_eq "wrong sha256 -> failed, not stored, still in the turn" \
      "SELECT w.status || '/' || (w.last_error->>'code') || '/' || (w.object_key IS NULL) FROM app.wa_media w JOIN app.wa_inbound_messages m ON m.id = w.inbound_message_id WHERE m.wamid = 'wamid.E2E-D4'" "failed/SHA256_MISMATCH/true"
    wait_eq "forbidden type (application/x-msdownload) -> rejected, nothing stored" \
      "SELECT w.status || '/' || (w.object_key IS NULL) FROM app.wa_media w JOIN app.wa_inbound_messages m ON m.id = w.inbound_message_id WHERE m.wamid = 'wamid.E2E-D5'" "rejected/true"
    log="$(stub_log)"
    assert_eq "too_large and forbidden files were never downloaded" \
      "$(jq '[.[] | select(.kind == "media-download" and (.mediaId == "STUB-BIG" or .mediaId == "STUB-EXE"))] | length' <<<"$log")" "0"
    assert_eq "T-09: the OpenAI stub received only the ogg voice note (audio/ogg, OggS)" \
      "$(jq -c '[.[] | select(.kind == "transcription")] | [length, all(.fileIsOgg == true and (.fileContentType | startswith("audio/ogg"))), (map(.language) | unique)]' <<<"$log")" '[1,true,["ar"]]'
    assert_eq "no image or PDF ever reached the OpenAI stub" \
      "$(jq '[.[] | select(.kind == "transcription" and ((.fileContentType // "") | test("image|pdf|application")))] | length' <<<"$log")" "0"
    assert_eq "the stub log holds no Authorization value" \
      "$(grep -cE 'Bearer|stub-not-a-real-key' <<<"$log")" "0"
    wait_eq "no URL in anything the API received" \
      "SELECT count(*) FROM hazem.turns WHERE wa_id IN ($ALL) AND messages::text LIKE '%://%'" "0"
    finish
    ;;

  stale-e)
    backup_set whatsapp.turn_stale_seconds 20
    # Inject and claim in ONE transaction, as if n8n had taken the turn and then died: no other
    # claimer (n8n's schedule) can see the message in between.
    psql_super office -v ev="$(event "$E" wamid.E2E-E1 text "$(text "رسالة وn8n بيعمل restart")")" <<'SQL' >/dev/null
BEGIN;
SELECT app.wa_process_event(:'ev'::jsonb);
UPDATE app.wa_inbound_messages SET received_at = now() - interval '10 seconds' WHERE wamid = 'wamid.E2E-E1';
SET LOCAL ROLE office_app;
SELECT app.wa_turns_claim(20, ARRAY['201000000065']);
COMMIT;
SQL
    echo "turn of wamid.E2E-E1 is processing and nobody will finish it (turn_stale_seconds = 20)"
    ;;

  check-stale)
    wait_eq "after n8n restarted, the stuck turn was taken again with the same turn_id (attempt 2)" \
      "SELECT m.processing_status || '/' || t.attempts || '/' || (SELECT count(*) FROM app.wa_turns WHERE wa_id = '$E') FROM app.wa_inbound_messages m JOIN app.wa_turns t USING (turn_id) WHERE m.wamid = 'wamid.E2E-E1'" "processed/2/1"
    wait_eq "and the client got exactly one reply" \
      "SELECT count(*) || '/' || max(attempts) FROM app.wa_outbound_messages WHERE wa_id = '$E'" "1/1"
    finish
    ;;

  # ---------------------------------------------------------------- TASK 04
  hazem-setup)
    # Hazem itself answers from now on; the classifier talks to the stub with a dummy key.
    # HAZEM_OPENAI_API_KEY in .env is never read or changed: the API ignores it while
    # ai.stub_enabled is true (and honours ai.stub_* only when ENVIRONMENT=test).
    hazem_backup_set responder hazem
    hazem_backup_set hazem.recipients "$F,$G"
    hazem_backup_set ai.stub_enabled true
    hazem_backup_set ai.stub_base_url "$STUB/v1"
    curl -s -X POST "$STUB/_log/reset" >/dev/null && curl -s -X POST "$STUB/_ai/up" >/dev/null || die "meta-stub is not running"
    inject "$F" wamid.E2E-F1 text "$(text "السلام عليكم عايز أحجز استشارة")" 10
    inject "$G" wamid.E2E-G1 image '{"id":"STUB-IMG","mime_type":"image/jpeg"}' 10
    echo "responder hazem for $F and $G; a booking request and a photo without words waiting"
    ;;

  check-hazem-welcome)
    wait_eq "new number asking to book -> the welcome and the name question (B-01)" \
      "SELECT COALESCE((SELECT string_agg(request_payload->'text'->>'body', ' || ') FROM app.wa_outbound_messages WHERE wa_id = '$F'), '')" "$WELCOME"
    wait_eq "the booking request is kept for after the name (B-01.4)" \
      "SELECT i.state || '/' || COALESCE(i.pending_intent, '') FROM hazem.intakes i JOIN hazem.persons p ON p.id = i.person_id WHERE p.wa_id = '$F'" "awaiting_name/consultation_request"
    wait_eq "a photo without words from a new number -> the welcome too" \
      "SELECT COALESCE((SELECT string_agg(request_payload->'text'->>'body', ' || ') FROM app.wa_outbound_messages WHERE wa_id = '$G'), '')" "$WELCOME"
    log="$(stub_log)"
    assert_eq "T-09: the photo turn never reached the AI stub (one classification only, the text)" \
      "$(jq '[.[] | select(.kind == "classification")] | length' <<<"$log")" "1"
    assert_eq "the AI got Structured Outputs (strict) and only the client's words" \
      "$(jq -c '[.[] | select(.kind == "classification")][0] | [.strict, .text]' <<<"$log")" '[true,"السلام عليكم عايز أحجز استشارة"]'
    finish
    ;;

  hazem-name)
    inject "$F" wamid.E2E-F2 text "$(text "محمد أحمد علي حسن")" 10
    echo "the name from $F"
    ;;

  check-hazem-offer)
    wait_eq "after the name: the consultation offer, without asking again" \
      "SELECT COALESCE((SELECT string_agg(request_payload->'text'->>'body', ' || ' ORDER BY created_at) FROM app.wa_outbound_messages WHERE wa_id = '$F'), '')" "$WELCOME || $OFFER"
    wait_eq "the person has a full name and the request is at offer_sent" \
      "SELECT p.full_name_provided || '/' || i.state || '/' || i.client_type FROM hazem.persons p JOIN hazem.intakes i ON i.person_id = p.id WHERE p.wa_id = '$F'" "true/offer_sent/new_client"
    wait_eq "every reply recorded with its approved text key and version" \
      "SELECT string_agg(r.text_key || ':' || r.text_version, ',' ORDER BY r.created_at) FROM hazem.turn_replies r JOIN hazem.turns t USING (turn_id) WHERE t.wa_id = '$F'" "welcome_ask_name:1,consultation_offer:1"
    finish
    ;;

  hazem-legal)
    inject "$F" wamid.E2E-F3 text "$(text "ينفع أطلق؟ كلمني على 01012345678")" 10
    echo "a legal question with a phone number from $F"
    ;;

  check-hazem-legal)
    wait_eq "legal question -> the B-20 text, then the offer" \
      "SELECT string_agg(request_payload->'text'->>'body', ' || ' ORDER BY idempotency_key) FROM app.wa_outbound_messages WHERE wa_id = '$F' AND idempotency_key LIKE 'hazem:' || (SELECT turn_id FROM app.wa_inbound_messages WHERE wamid = 'wamid.E2E-F3') || ':%'" "$LEGAL || $OFFER"
    log="$(stub_log)"
    assert_eq "the phone number never reached the AI: replaced by [رقم]" \
      "$(jq -r '[.[] | select(.kind == "classification")] | last | .text' <<<"$log")" "ينفع أطلق؟ كلمني على [رقم]"
    assert_eq "no digits of a phone, no file field and no Authorization value in anything the stub got" \
      "$(grep -cE '0101|office-sensitive|wa/20|Bearer|not-a-real-key' <<<"$log")" "0"
    wait_eq "the classification log holds no client text" \
      "SELECT count(*) FROM hazem.classifications c JOIN hazem.turns t USING (turn_id) WHERE t.wa_id = '$F' AND row_to_json(c)::text ~ '(أطلق|0101|محمد)'" "0"
    finish
    ;;

  hazem-ai-down)
    curl -s -X POST "$STUB/_ai/down" >/dev/null || die "meta-stub is not running"
    inject "$F" wamid.E2E-F4 text "$(text "عايز أحجز")" 10
    echo "the AI stub answers 503; a booking request from $F"
    ;;

  check-hazem-fallback)
    wait_eq "AI down: the client still gets an answer (the offer, as the unclear fallback)" \
      "SELECT string_agg(request_payload->'text'->>'body', ' || ') FROM app.wa_outbound_messages WHERE wa_id = '$F' AND idempotency_key LIKE 'hazem:' || (SELECT turn_id FROM app.wa_inbound_messages WHERE wamid = 'wamid.E2E-F4') || ':%'" "$OFFER"
    wait_eq "AI down: classified as other with the reason" \
      "SELECT intent || '/' || fallback_reason FROM hazem.classifications WHERE turn_id = (SELECT turn_id FROM app.wa_inbound_messages WHERE wamid = 'wamid.E2E-F4')" "other/error"
    curl -s -X POST "$STUB/_ai/up" >/dev/null
    finish
    ;;

  check-restored)
    assert_eq "settings back to normal: dry run off, stale 300, real Graph and OpenAI URLs, no backups left" \
      "$(q "SELECT string_agg(key || '=' || value, ',' ORDER BY key) FROM app.settings WHERE key IN ('whatsapp.dry_run','whatsapp.turn_stale_seconds','whatsapp.graph_base_url','ai.openai_base_url') OR key LIKE 'e2e.backup.%'")" \
      "ai.openai_base_url=https://api.openai.com/v1,whatsapp.dry_run=false,whatsapp.graph_base_url=https://graph.facebook.com,whatsapp.turn_stale_seconds=300"
    assert_eq "Hazem settings back: responder hazem, AI stub off, no backups left" \
      "$(q "SELECT string_agg(key || '=' || value, ',' ORDER BY key) FROM hazem.settings WHERE key IN ('responder','ai.stub_enabled','ai.stub_base_url','echo.enabled') OR key LIKE 'e2e.backup.%'")" \
      "ai.stub_base_url=,ai.stub_enabled=false,echo.enabled=false,responder=hazem"
    assert_eq "no test number left in the API's tables" \
      "$(q "SELECT count(*) FROM hazem.persons WHERE wa_id IN ($ALL)")" "0"
    assert_eq "no test credential left in n8n" \
      "$(psql_super n8n -c "SELECT count(*) FROM credentials_entity WHERE id IN ('TestMetaToken001', 'TestOpenAiKey001')")" "0"
    finish
    ;;

  *)
    die "usage: hazem-e2e setup|check-loop|replay|check-replay|inject-b|check-api-down|check-recovered|check-api-send|check-auth|group-c|check-group|media-d|check-media|stale-e|check-stale|cleanup|remove-test-credentials|check-restored|hazem-setup|check-hazem-welcome|hazem-name|check-hazem-offer|hazem-legal|check-hazem-legal|hazem-ai-down|check-hazem-fallback"
    ;;
esac
