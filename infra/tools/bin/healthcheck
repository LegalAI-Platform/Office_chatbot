#!/bin/bash
# Full environment check (TASK 01, section 10). Prints PASS/FAIL per item.
# Exit code 0 only when every item passes.
set -uo pipefail
source /usr/local/bin/_lib

passed=0; failed=0
check() {  # check "description" command...
  local desc="$1"; shift
  if "$@" >/dev/null 2>&1; then
    echo "PASS  $desc"; passed=$((passed+1))
  else
    echo "FAIL  $desc"; failed=$((failed+1))
  fi
}
expect_fail() { ! "$@"; }
warned=0
warn() { echo "WARN  $*"; warned=$((warned+1)); }
sql_equals() {  # sql_equals DB "SQL" EXPECTED
  [[ "$(psql_super "$1" -c "$2")" == "$3" ]]
}
http_status_is() { [[ "$(curl -s -o /dev/null -w '%{http_code}' "$1")" == "$2" ]]; }
redis_reply_matches() {  # redis_reply_matches with-auth|no-auth PATTERN CMD...
  local mode="$1" pattern="$2"; shift 2
  local reply
  if [[ "$mode" == "with-auth" ]]; then
    reply="$(REDISCLI_AUTH="$REDIS_PASSWORD" redis-cli -h redis "$@" 2>&1)"
  else
    reply="$(env -u REDISCLI_AUTH redis-cli -h redis "$@" 2>&1)"
  fi
  [[ "$reply" == $pattern ]]
}
bucket_private() { garage_api GET "/v2/GetBucketInfo?globalAlias=$1" | jq -e '.websiteAccess == false'; }
lifecycle_30_days() {
  s3_as backup s3api get-bucket-lifecycle-configuration --bucket "$BUCKET_BACKUPS" \
    | jq -e '.Rules[0].Expiration.Days == 30 and .Rules[0].Status == "Enabled"'
}

echo "== Containers"
for svc in postgres redis garage n8n api web; do
  check "$svc reachable on the internal network" getent hosts "$svc"
done

echo "== PostgreSQL"
check "office_app can connect to office" \
  psql_as office_app "$OFFICE_APP_PASSWORD" office -c 'SELECT 1'
check "office_app cannot CREATE TABLE in schema app" \
  expect_fail psql_as office_app "$OFFICE_APP_PASSWORD" office -c 'CREATE TABLE app.__hc_probe(x int)'
check "office_app cannot CREATE TABLE in schema public" \
  expect_fail psql_as office_app "$OFFICE_APP_PASSWORD" office -c 'CREATE TABLE public.__hc_probe(x int)'
check "office_readonly can read office" \
  psql_as office_readonly "$OFFICE_READONLY_PASSWORD" office -c 'SELECT 1'
check "office_readonly cannot INSERT" \
  expect_fail psql_as office_readonly "$OFFICE_READONLY_PASSWORD" office -c 'INSERT INTO public.schema_migrations(version) VALUES ($$__hc$$)'
check "n8n_user cannot connect to office" \
  expect_fail psql_as n8n_user "$N8N_DB_PASSWORD" office -c 'SELECT 1'
check "office_app cannot connect to n8n" \
  expect_fail psql_as office_app "$OFFICE_APP_PASSWORD" n8n -c 'SELECT 1'
check "server timezone is Africa/Cairo" sql_equals postgres "SHOW timezone" "Africa/Cairo"
check "office_api (.NET) can connect to office" \
  psql_as office_api "$OFFICE_API_PASSWORD" office -c 'SELECT 1'
check "office_api can write schema hazem (rolled back)" \
  psql_as office_api "$OFFICE_API_PASSWORD" office -c 'BEGIN; DELETE FROM hazem.turns WHERE false; ROLLBACK;'
check "office_api cannot CREATE TABLE in schema hazem" \
  expect_fail psql_as office_api "$OFFICE_API_PASSWORD" office -c 'CREATE TABLE hazem.__hc_probe(x int)'
check "office_api cannot read the WhatsApp tables (schema app)" \
  expect_fail psql_as office_api "$OFFICE_API_PASSWORD" office -c 'SELECT 1 FROM app.wa_inbound_messages LIMIT 1'
check "office_app (n8n) cannot read the API tables (schema hazem)" \
  expect_fail psql_as office_app "$OFFICE_APP_PASSWORD" office -c 'SELECT 1 FROM hazem.turns LIMIT 1'
check "office_api cannot connect to n8n" \
  expect_fail psql_as office_api "$OFFICE_API_PASSWORD" n8n -c 'SELECT 1'

echo "== n8n"
check "n8n /healthz returns 200" http_status_is http://n8n:5678/healthz 200
check "n8n /healthz/readiness returns 200 (database connected, migrations done)" \
  http_status_is http://n8n:5678/healthz/readiness 200
check "n8n stores its data in PostgreSQL (core tables exist in database n8n)" \
  sql_equals n8n "SELECT count(*) FROM information_schema.tables WHERE table_schema = 'public' AND table_name IN ('workflow_entity', 'credentials_entity', 'user')" "3"

echo "== Redis"
check "PING with password returns PONG" redis_reply_matches with-auth "PONG" ping
check "PING without password is rejected" redis_reply_matches no-auth "*NOAUTH*" ping
check "FLUSHALL is disabled" redis_reply_matches with-auth "*unknown command*" FLUSHALL

echo "== Object storage (Garage)"
for b in "$BUCKET_MEDIA" "$BUCKET_SENSITIVE" "$BUCKET_BACKUPS"; do
  check "bucket $b exists" garage_api GET "/v2/GetBucketInfo?globalAlias=$b"
  check "bucket $b has no public (website) access" bucket_private "$b"
  check "bucket $b refuses anonymous listing" expect_fail s3_as anon s3 ls "s3://$b"
done
probe="healthcheck/probe-$(date +%s).txt"
echo "probe" > /tmp/probe.txt
check "n8n key can write to $BUCKET_MEDIA" s3_as n8n s3 cp /tmp/probe.txt "s3://$BUCKET_MEDIA/$probe"
check "n8n key can write to $BUCKET_SENSITIVE" s3_as n8n s3 cp /tmp/probe.txt "s3://$BUCKET_SENSITIVE/$probe"
check "n8n key cannot write to $BUCKET_BACKUPS" expect_fail s3_as n8n s3 cp /tmp/probe.txt "s3://$BUCKET_BACKUPS/$probe"
check "backup key can write to $BUCKET_BACKUPS" s3_as backup s3 cp /tmp/probe.txt "s3://$BUCKET_BACKUPS/$probe"
# TASK 13: the backup key reads the client files to back them up (and never writes them: «Backups and security» below).
check "backup key cannot write to $BUCKET_SENSITIVE" expect_fail s3_as backup s3 cp /tmp/probe.txt "s3://$BUCKET_SENSITIVE/$probe"
# TASK 10 (v1.14): the api signs the upload of a delivered file into office-sensitive/deliverables/; nowhere else.
check "api key can write a delivered file to $BUCKET_SENSITIVE" s3_as api s3 cp /tmp/probe.txt "s3://$BUCKET_SENSITIVE/deliverables/$probe"
check "api key cannot write to $BUCKET_MEDIA" expect_fail s3_as api s3 cp /tmp/probe.txt "s3://$BUCKET_MEDIA/$probe"
check "api key cannot read $BUCKET_BACKUPS" expect_fail s3_as api s3 ls "s3://$BUCKET_BACKUPS"
s3_as api s3 rm "s3://$BUCKET_SENSITIVE/deliverables/$probe" >/dev/null 2>&1 || true
check "lifecycle: $BUCKET_BACKUPS expires objects after 30 days" lifecycle_30_days
s3_as n8n s3 rm "s3://$BUCKET_MEDIA/$probe" >/dev/null 2>&1 || true
s3_as n8n s3 rm "s3://$BUCKET_SENSITIVE/$probe" >/dev/null 2>&1 || true
s3_as backup s3 rm "s3://$BUCKET_BACKUPS/$probe" >/dev/null 2>&1 || true

echo "== WhatsApp (TASK 02)"
check "WhatsApp tables exist (8)" \
  sql_equals office "SELECT count(*) FROM information_schema.tables WHERE table_schema = 'app' AND table_name IN ('settings','wa_webhook_events','wa_inbound_messages','wa_contact_windows','wa_outbound_messages','wa_message_statuses','wa_templates','workflow_errors')" "8"
check "office_app can write WhatsApp tables (rolled back)" \
  psql_as office_app "$OFFICE_APP_PASSWORD" office -c 'BEGIN; DELETE FROM app.wa_templates WHERE false; ROLLBACK;'
check "office_app cannot ALTER WhatsApp tables" \
  expect_fail psql_as office_app "$OFFICE_APP_PASSWORD" office -c 'ALTER TABLE app.wa_templates ADD COLUMN __hc int'
check "office_readonly cannot write WhatsApp tables" \
  expect_fail psql_as office_readonly "$OFFICE_READONLY_PASSWORD" office -c 'DELETE FROM app.wa_templates'
check "office_app may run the WhatsApp functions" \
  sql_equals office "SELECT has_function_privilege('office_app', 'app.wa_process_event(jsonb)', 'EXECUTE')::text" "true"
check "office_readonly may not run them" \
  sql_equals office "SELECT has_function_privilege('office_readonly', 'app.wa_process_event(jsonb)', 'EXECUTE')::text" "false"
check "dry run is off (whatsapp.dry_run = false: real sends reach Meta)" \
  sql_equals office "SELECT value FROM app.settings WHERE key = 'whatsapp.dry_run'" "false"
check "n8n has the 17 workflows (TASK 02, v1.3 hand-off, TASK 03 media)" \
  sql_equals n8n "SELECT count(*) FROM workflow_entity WHERE id IN ('WaCfgGet00000001','WaErrHandler0001','WaInbound0000001','WaProcEvent00001','WaSendMsg0000001','WaSendTpl0000001','WaSubCheck000001','WaSubDelete00001','WaTplSubmit00001','WaTplSync0000001','WaTestHarness001','WaFwdTurn0000001','WaHandleTurn0001','WaSendAction0001','WaIntSend0000001','WaMediaFetch0001','WaMediaOne000001')" "17"
check "n8n has the credentials from .env (office-postgres-app, hazem-api, hazem-internal-send, office-s3)" \
  sql_equals n8n "SELECT count(*) FROM credentials_entity WHERE name IN ('office-postgres-app','hazem-api','hazem-internal-send','office-s3')" "4"

echo "== n8n <-> .NET API (DECISIONS v1.3)"
api_status() {  # api_status URL [curl args...] -> HTTP status of a POST with a JSON body {}
  local url="$1"; shift
  curl -s -o /dev/null -w '%{http_code}' -X POST -H 'Content-Type: application/json' -d '{}' "$@" "$url"
}
check "API is ready (database as office_api, schema hazem)" \
  bash -c '[[ "$(curl -s http://api:8080/health/ready)" == Healthy ]]'
check "API refuses a request without X-Hazem-Token (401)" \
  test "$(api_status http://api:8080/api/hazem/turns)" = 401
check "API accepts n8n's token (an empty turn is 400, not 401)" \
  test "$(api_status http://api:8080/api/hazem/turns -H "X-Hazem-Token: $HAZEM_API_TOKEN")" = 400
check "n8n internal send webhook is live and refuses a request without the token (403)" \
  test "$(api_status http://n8n:5678/webhook/hazem-internal-send)" = 403
check "API echo test is switched off" \
  sql_equals office "SELECT value FROM hazem.settings WHERE key = 'echo.enabled'" "false"
check "no message waiting for the API for more than 10 minutes" \
  sql_equals office "SELECT count(*) FROM app.wa_inbound_messages WHERE NOT is_group AND processing_status IN ('pending', 'processing') AND received_at < now() - interval '10 minutes'" "0"

echo "== Messages, media and voice (TASK 03)"
check "tables wa_turns and wa_media exist" \
  sql_equals office "SELECT count(*) FROM information_schema.tables WHERE table_schema = 'app' AND table_name IN ('wa_turns', 'wa_media')" "2"
check "office_app can write wa_turns and wa_media (rolled back)" \
  psql_as office_app "$OFFICE_APP_PASSWORD" office -c 'BEGIN; DELETE FROM app.wa_media WHERE false; DELETE FROM app.wa_turns WHERE false; ROLLBACK;'
check "office_api cannot read wa_media or wa_turns" \
  expect_fail psql_as office_api "$OFFICE_API_PASSWORD" office -c 'SELECT 1 FROM app.wa_media UNION ALL SELECT 1 FROM app.wa_turns LIMIT 1'
check "office_readonly cannot claim turns or media" \
  sql_equals office "SELECT (has_function_privilege('office_readonly', 'app.wa_turns_claim(int, text[])', 'EXECUTE') OR has_function_privilege('office_readonly', 'app.wa_media_claim(int, text[])', 'EXECUTE'))::text" "false"
check "real Meta and OpenAI URLs, turn_stale_seconds = 300 (test values never left behind)" \
  sql_equals office "SELECT string_agg(key || '=' || value, ',' ORDER BY key) FROM app.settings WHERE key IN ('whatsapp.graph_base_url', 'ai.openai_base_url', 'whatsapp.turn_stale_seconds') OR key LIKE 'e2e.backup.%'" "ai.openai_base_url=https://api.openai.com/v1,whatsapp.graph_base_url=https://graph.facebook.com,whatsapp.turn_stale_seconds=300"
check "no turn stuck in processing for more than 10 minutes" \
  sql_equals office "SELECT count(*) FROM app.wa_turns WHERE status = 'processing' AND claimed_at < now() - interval '10 minutes'" "0"
check "no download stuck for more than 10 minutes" \
  sql_equals office "SELECT count(*) FROM app.wa_media WHERE status = 'downloading' AND claimed_at < now() - interval '10 minutes'" "0"
check "no test credential (TestMetaToken001, TestOpenAiKey001) left in n8n" \
  sql_equals n8n "SELECT count(*) FROM credentials_entity WHERE id IN ('TestMetaToken001', 'TestOpenAiKey001')" "0"
check "meta-stub (test only) is not running" \
  expect_fail getent hosts meta-stub
if [[ "$(psql_super n8n -c "SELECT count(*) FROM credentials_entity WHERE name = 'openai-transcription'")" != "1" ]]; then
  warn "n8n credential openai-transcription does not exist yet: voice notes reach the API without a transcript (docs/meta-setup.md, owner only)"
fi

echo "== Hazem understands and answers (TASK 04)"
check "tables persons, conversations, intakes, approved_texts, turn_replies, classifications, staff_tasks exist" \
  sql_equals office "SELECT count(*) FROM information_schema.tables WHERE table_schema = 'hazem' AND table_name IN ('persons', 'conversations', 'intakes', 'approved_texts', 'turn_replies', 'classifications', 'staff_tasks')" "7"
check "office_api can write the TASK 04 tables (rolled back)" \
  psql_as office_api "$OFFICE_API_PASSWORD" office -c 'BEGIN; DELETE FROM hazem.persons WHERE false; DELETE FROM hazem.classifications WHERE false; DELETE FROM hazem.turn_replies WHERE false; ROLLBACK;'
check "office_app (n8n) cannot read persons, texts or classifications" \
  expect_fail psql_as office_app "$OFFICE_APP_PASSWORD" office -c 'SELECT 1 FROM hazem.persons UNION ALL SELECT 1 FROM hazem.approved_texts UNION ALL SELECT 1 FROM hazem.classifications LIMIT 1'
check "office_readonly can read the TASK 04 tables but not write them" \
  sql_equals office "SELECT (has_table_privilege('office_readonly', 'hazem.persons', 'SELECT') AND has_table_privilege('office_readonly', 'hazem.classifications', 'SELECT') AND NOT has_table_privilege('office_readonly', 'hazem.persons', 'INSERT'))::text" "true"
check "responder = hazem (echo only inside hazem-e2e)" \
  sql_equals office "SELECT value FROM hazem.settings WHERE key = 'responder'" "hazem"
check "classifier on the real OpenAI URL (OPENAI_BASE_URL empty or the default)" \
  bash -c '[[ -z "${OPENAI_BASE_URL:-}" || "$OPENAI_BASE_URL" == "https://api.openai.com/v1" ]]'
check "no AI test stub left behind (ai.stub_enabled = false, ai.stub_base_url empty)" \
  sql_equals office "SELECT string_agg(key || '=' || value, ',' ORDER BY key) FROM hazem.settings WHERE key IN ('ai.stub_enabled', 'ai.stub_base_url')" "ai.stub_base_url=,ai.stub_enabled=false"
check "no active approved text has an unfilled office placeholder ({{OFFICE_ADDRESS}}, [..]; system slots like {{media}} are filled by Hazem)" \
  sql_equals office "SELECT count(*) FROM hazem.approved_texts WHERE active AND regexp_replace(text, '\{\{[a-z_]+\}\}', '', 'g') ~ '\{\{|\['" "0"
check "the classification log has no column for client text or names" \
  sql_equals office "SELECT count(*) FROM information_schema.columns WHERE table_schema = 'hazem' AND table_name = 'classifications' AND column_name ~ '(text|name|message)' AND column_name <> 'full_name_present'" "0"
if [[ -z "${HAZEM_OPENAI_API_KEY:-}" ]]; then
  warn "HAZEM_OPENAI_API_KEY is empty: classification is off and Hazem answers text as unclear (docs/ai/classification.md, owner only)"
fi
if [[ "$(psql_super office -c "SELECT value FROM hazem.settings WHERE key = 'hazem.open_to_all'")" == "true" ]]; then
  warn "hazem.open_to_all is true: Hazem answers EVERY number (the owner's decision only, CLAUDE.md)"
fi

echo "== Who is writing, tasks and topics (TASK 05a)"
check "tables staff, list_entries, staff_tasks exist" \
  sql_equals office "SELECT count(*) FROM information_schema.tables WHERE table_schema = 'hazem' AND table_name IN ('staff', 'list_entries', 'staff_tasks')" "3"
check "office_app (n8n) cannot read the office lists or the staff tasks" \
  expect_fail psql_as office_app "$OFFICE_APP_PASSWORD" office -c 'SELECT 1 FROM hazem.list_entries UNION ALL SELECT 1 FROM hazem.staff_tasks LIMIT 1'
check "handoff.enabled = true: a client handed over is answered from Chatwoot (TASK 07b)" \
  sql_equals office "SELECT value FROM hazem.settings WHERE key = 'handoff.enabled'" "true"

echo "== Chatwoot (TASK 07b, T-24)"
check "Chatwoot answers on chatwoot_net" http_status_is "http://chatwoot:3000/api" "200"
check "no turn waits more than 10 minutes to reach Chatwoot" \
  sql_equals office "SELECT count(*) FROM hazem.chatwoot_turns WHERE state = 'failed' AND updated_at < now() - interval '10 minutes'" "0"
check "no staff reply is stuck while sending" \
  sql_equals office "SELECT count(*) FROM hazem.chatwoot_replies WHERE state = 'sending' AND created_at < now() - interval '5 minutes'" "0"
check "no active approved text promises a contact time (B-06 promises wait for the alerts, TASK 07c)" \
  sql_equals office "SELECT count(*) FROM hazem.approved_texts WHERE active AND text ~ '(خلال ساعة|الساعة 10|هيتواصل|هيرد عليك)'" "0"

echo "== Who may receive messages (CLAUDE.md, migration 0006)"
check "every send is limited to whatsapp.test_recipients unless the owner decided otherwise (setting exists)" \
  sql_equals office "SELECT count(*) FROM app.settings WHERE key = 'whatsapp.send_restricted' AND value IN ('true', 'false')" "1"
check "no wa-db-tests backup left behind" \
  sql_equals office "SELECT count(*) FROM app.settings WHERE key LIKE 'wadb.backup.%'" "0"
if [[ "$(psql_super office -c "SELECT value FROM app.settings WHERE key = 'whatsapp.send_restricted'")" == "false" ]]; then
  warn "whatsapp.send_restricted is false: messages may go to ANY number (the owner's decision only, CLAUDE.md)"
fi

echo "== The panel (TASK 07a, DECISIONS v1.8 T-11 / T-23)"
check "web serves the panel (/healthz and the page)"   bash -c '[[ "$(curl -s http://web:8080/healthz)" == ok ]] && [[ "$(curl -s -o /dev/null -w "%{http_code}" http://web:8080/)" == 200 ]]'
check "web forwards /api/panel to the API (not signed in: 401)" http_status_is http://web:8080/api/panel/auth/me 401
check "web never forwards n8n's endpoints (/api/hazem/* through the panel: 404)"   test "$(api_status http://web:8080/api/hazem/turns -H "X-Hazem-Token: $HAZEM_API_TOKEN")" = 404
check "web sends the security headers (strict CSP, no framing, no referrer)"   bash -c 'h="$(curl -sI http://web:8080/)"; grep -qi "^content-security-policy: default-src .self.;" <<<"$h" && grep -qi "^x-frame-options: DENY" <<<"$h" && grep -qi "^referrer-policy: no-referrer" <<<"$h"'
check "tables panel_users and panel_audit exist"   sql_equals office "SELECT count(*) FROM information_schema.tables WHERE table_schema = 'hazem' AND table_name IN ('panel_users', 'panel_audit')" "2"
check "office_readonly cannot read password hashes or security stamps"   expect_fail psql_as office_readonly "$OFFICE_READONLY_PASSWORD" office -c 'SELECT password_hash, security_stamp FROM hazem.panel_users LIMIT 1'
check "office_app (n8n) cannot read panel accounts"   expect_fail psql_as office_app "$OFFICE_APP_PASSWORD" office -c 'SELECT 1 FROM hazem.panel_users LIMIT 1'
check "no test account left behind (e2e-*)"   sql_equals office "SELECT count(*) FROM hazem.panel_users WHERE username LIKE 'e2e-%'" "0"
if [[ "$(psql_super office -c "SELECT count(*) FROM hazem.panel_users WHERE active AND role = 'manager'")" == "0" ]]; then
  warn "no panel manager yet: the owner creates the first one from the terminal (docs/runbooks/panel.md)"
fi

echo "== The booking (TASK 08, DECISIONS v1.12 B-24)"
check "tables booking_weekly_hours, booking_exceptions, booking_changes, appointments exist" \
  sql_equals office "SELECT count(*) FROM information_schema.tables WHERE table_schema = 'hazem' AND table_name IN ('booking_weekly_hours', 'booking_exceptions', 'booking_changes', 'appointments')" "4"
check "two confirmed appointments can never overlap (constraint appointments_no_overlap)" \
  sql_equals office "SELECT count(*) FROM pg_constraint WHERE conname = 'appointments_no_overlap'" "1"
check "office_app (n8n) cannot read the appointments or the booking hours" \
  expect_fail psql_as office_app "$OFFICE_APP_PASSWORD" office -c 'SELECT 1 FROM hazem.appointments UNION ALL SELECT 1 FROM hazem.booking_weekly_hours LIMIT 1'
check "the calendar is the real Google (booking.google_base_url empty: no test stub left)" \
  sql_equals office "SELECT value FROM hazem.settings WHERE key = 'booking.google_base_url'" ""
check "no test booking left behind (no day closed by hazem-e2e, its texts switched off again)" \
  sql_equals office "SELECT (SELECT count(*) FROM hazem.booking_exceptions WHERE reason = 'e2e') + (SELECT count(*) FROM hazem.settings WHERE key = 'e2e.texts08')" "0"
check "no calendar event stuck (an appointment tried 6 times or more)" \
  sql_equals office "SELECT count(*) FROM hazem.appointments WHERE calendar_state IN ('create', 'update', 'remove') AND calendar_attempts >= 6" "0"
if [[ "$(psql_super office -c "SELECT count(*) FROM hazem.settings WHERE key IN ('office.instapay', 'office.wallet_number') AND (value ILIKE '%test%' OR value = '01000000000')")" != "0" ]]; then
  warn "the office's InstaPay or wallet are TEST values: write the real ones in the panel (المواعيد ← بيانات المكتب) before clients book"
fi
if [[ -z "${GOOGLE_SERVICE_ACCOUNT_JSON:-}" ]]; then
  warn "GOOGLE_SERVICE_ACCOUNT_JSON is empty: Hazem offers no booking times until the lawyer's calendar is connected (docs/runbooks/booking.md, owner only)"
fi

echo "== The payments (TASK 09, DECISIONS v1.13 B-05 / B-22)"
check "tables payments and payment_receipts exist" \
  sql_equals office "SELECT count(*) FROM information_schema.tables WHERE table_schema = 'hazem' AND table_name IN ('payments', 'payment_receipts')" "2"
check "a client holds one time at a time (index appointments_one_hold)" \
  sql_equals office "SELECT count(*) FROM pg_indexes WHERE schemaname = 'hazem' AND indexname = 'appointments_one_hold'" "1"
check "the hold's settings are there (booking.hold_*)" \
  sql_equals office "SELECT count(*) FROM hazem.settings WHERE key IN ('booking.hold_minutes', 'booking.hold_short_minutes', 'booking.hold_short_within_hours', 'booking.hold_gap_minutes') AND value ~ '^[0-9]+$'" "4"
check "office_app (n8n) cannot read the payments or the receipts" \
  expect_fail psql_as office_app "$OFFICE_APP_PASSWORD" office -c 'SELECT 1 FROM hazem.payments UNION ALL SELECT 1 FROM hazem.payment_receipts LIMIT 1'
check "no hold forgotten by the worker (a hold more than 10 minutes past its time)" \
  sql_equals office "SELECT count(*) FROM hazem.appointments WHERE state = 'pending_payment' AND hold_until < now() - interval '10 minutes'" "0"
if [[ "$(psql_super office -c "SELECT count(*) FROM hazem.approved_texts WHERE source = 'proposal TASK 09' AND active")" == "0" ]]; then
  warn "TASK 09's texts are not approved yet: booking from WhatsApp stays off until the owner approves them (docs/approved-texts-proposal.md)"
fi

echo "== The written services (TASK 10, DECISIONS v1.14 B-16 / B-17 / S-07)"
check "tables service_orders and service_files exist" \
  sql_equals office "SELECT count(*) FROM information_schema.tables WHERE table_schema = 'hazem' AND table_name IN ('service_orders', 'service_files')" "2"
check "a payment belongs to one booking or one order (payments_one_owner)" \
  sql_equals office "SELECT count(*) FROM pg_constraint WHERE conname = 'payments_one_owner'" "1"
check "office_app (n8n) cannot read the orders or their files" \
  expect_fail psql_as office_app "$OFFICE_APP_PASSWORD" office -c 'SELECT 1 FROM hazem.service_orders UNION ALL SELECT 1 FROM hazem.service_files LIMIT 1'
check "no price forgotten by the worker (an order more than 10 minutes past its price's time)" \
  sql_equals office "SELECT count(*) FROM hazem.service_orders WHERE state = 'awaiting_payment' AND price_until < now() - interval '10 minutes'" "0"
if [[ "$(psql_super office -c "SELECT count(*) FROM hazem.approved_texts WHERE source = 'proposal TASK 10' AND active")" == "0" ]]; then
  warn "TASK 10's texts are not approved yet: Hazem answers a written service as before and opens no order (docs/approved-texts-proposal.md)"
fi

echo "== The Urfi paths (TASK 11, DECISIONS v1.15 B-11 / S-06)"
check "tables urf_cases and urf_files exist" \
  sql_equals office "SELECT count(*) FROM information_schema.tables WHERE table_schema = 'hazem' AND table_name IN ('urf_cases', 'urf_files')" "2"
check "office_app (n8n) cannot read the Urfi cases or their documents" \
  expect_fail psql_as office_app "$OFFICE_APP_PASSWORD" office -c 'SELECT 1 FROM hazem.urf_cases UNION ALL SELECT 1 FROM hazem.urf_files LIMIT 1'
check "the Urfi appointment length is set (booking.urf_minutes, 15 to 480)" \
  sql_equals office "SELECT count(*) FROM hazem.settings WHERE key = 'booking.urf_minutes' AND value ~ '^[0-9]+$' AND value::int BETWEEN 15 AND 480" "1"
# By key, not by source: the office may reword one in «نصوص حازم» (a new version, source «panel …»).
check "B-11's questions and answers have an active text (10 keys)" \
  sql_equals office "SELECT count(DISTINCT key) FROM hazem.approved_texts WHERE active AND key IN ('urf_ask_ages', 'urf_under_age', 'urf_ask_wife_past', 'urf_ask_guardian', 'urf_no_guardian', 'urf_ask_witnesses', 'urf_ask_copy', 'urf_ask_agreed', 'urf_ask_children', 'urf_confirmed')" "10"
if [[ "$(psql_super office -c "SELECT count(*) FROM hazem.approved_texts WHERE source = 'proposal TASK 11' AND active")" == "0" ]]; then
  warn "TASK 11's texts are not approved yet: Hazem answers an Urfi request as before (the text and a task) (docs/approved-texts-proposal.md)"
fi

echo "== The reminders (TASK 12, DECISIONS v1.16 B-18 / M-03)"
check "table appointment_reminders exists" \
  sql_equals office "SELECT count(*) FROM information_schema.tables WHERE table_schema = 'hazem' AND table_name = 'appointment_reminders'" "1"
check "office_app (n8n) cannot read the reminders" \
  expect_fail psql_as office_app "$OFFICE_APP_PASSWORD" office -c 'SELECT 1 FROM hazem.appointment_reminders LIMIT 1'
check "no reminder forgotten by the worker (one more than 10 minutes past its time)" \
  sql_equals office "SELECT count(*) FROM hazem.appointment_reminders WHERE (state = 'scheduled' AND due_at < now() - interval '10 minutes') OR (state = 'sending' AND updated_at < now() - interval '10 minutes')" "0"
# By key, not by source: the office may reword one in «نصوص حازم» (a new version, source «panel …»).
check "every reminder text is active (9 keys; without one, no reminder is sent)" \
  sql_equals office "SELECT count(DISTINCT key) FROM hazem.approved_texts WHERE active AND key IN ('reminder_day_before', 'reminder_2h_before', 'btn_reminder_attend', 'btn_reminder_change', 'reminder_attend_ok', 'reminder_details_office', 'reminder_details_phone', 'reminder_details_urf', 'reminder_old_button')" "9"
if [[ "$(psql_super office -c "SELECT count(*) FROM hazem.staff_tasks WHERE type = 'reminder_failed' AND state NOT IN ('done', 'cancelled')")" != "0" ]]; then
  warn "a reminder could not reach a client (outside the 24 hours the M-03 templates need Meta's approval): the office reminds by phone (the tasks)"
fi

echo "== The prices and the office's questions (TASK 06, DECISIONS v1.17 B-20 / B-23)"
check "the price list has its 10 lines, each a whole number from 1 to 1,000,000 (price.*)" \
  sql_equals office "SELECT count(*) FROM hazem.settings WHERE key IN ('price.phone_video', 'price.office', 'price.urgent', 'price.review_min',
    'price.review_max', 'price.drafting_from', 'price.formal_notice', 'price.written_opinion', 'price.urf_office_witnesses', 'price.urf_own_witnesses')
    AND value ~ '^[1-9][0-9]{0,6}$' AND value::int <= 1000000" "10"
check "the review's range is the right way round (price.review_min <= price.review_max)" \
  sql_equals office "SELECT (hazem.price('price.review_min', 1500) <= hazem.price('price.review_max', 3000))::text" "true"
check "no active text quotes a price as a fixed number where B-23 has a slot (the prices come from the panel)" \
  sql_equals office "SELECT count(*) FROM hazem.approved_texts WHERE active AND key IN ('consultation_offer', 'urgent_price', 'price_formal_notice', 'price_urf')
    AND text !~ '\{\{price_' AND updated_by NOT LIKE 'panel%'" "0"
if [[ "$(psql_super office -c "SELECT count(*) FROM hazem.settings WHERE key IN ('office.address', 'office.map_url') AND value <> ''")" != "2" ]]; then
  warn "the office's address or map link is empty: «المكتب فين؟» gets the offer and a task until they are written (المواعيد ← بيانات المكتب)"
fi
if [[ "$(psql_super office -c "SELECT count(*) FROM hazem.approved_texts WHERE source = 'proposal TASK 06' AND active")" == "0" ]]; then
  warn "TASK 06's texts are not approved yet: an office question gets the consultation offer only (docs/approved-texts-proposal.md)"
fi

echo "== Backups and security (TASK 13, DECISIONS v1.18)"
check "table ops_runs exists (the nightly jobs' records)" \
  sql_equals office "SELECT count(*) FROM information_schema.tables WHERE table_schema = 'hazem' AND table_name = 'ops_runs'" "1"
check "BACKUP_ENCRYPTION_KEY is set (64 hex): every backup is encrypted" \
  bash -c '[[ "${BACKUP_ENCRYPTION_KEY:-}" =~ ^[0-9a-f]{64}$ ]]'
check "the backup key reads the client files and cannot write them" \
  bash -c 's3_as backup s3 ls "s3://$BUCKET_SENSITIVE/" >/dev/null 2>&1 && ! echo x | s3_as backup s3 cp - "s3://$BUCKET_SENSITIVE/healthcheck-probe" >/dev/null 2>&1'
check "office-backups never expires the files themselves (lifecycle on postgres/ and files/manifests/ only)" \
  bash -c 's3_as backup s3api get-bucket-lifecycle-configuration --bucket "$BUCKET_BACKUPS" --output json | jq -e "[.Rules[] | select(.Status == \"Enabled\") | (.Filter.Prefix // .Prefix // \"\")] | sort == [\"files/manifests/\", \"postgres/\"]" >/dev/null'
ops_last() {  # ops_last KIND -> "none", or "<ok>|<hours since the last run that worked>"
  psql_super office -c "SELECT coalesce((SELECT ok::text FROM hazem.ops_runs WHERE kind = '$1' AND finished_at IS NOT NULL ORDER BY started_at DESC LIMIT 1), 'none')
    || coalesce('|' || (SELECT floor(extract(epoch FROM now() - max(started_at)) / 3600)::int FROM hazem.ops_runs WHERE kind = '$1' AND ok), '|-1')" 2>/dev/null || echo "none|-1"
}
for job in "backup:26:the nightly backup" "drill:840:the monthly restore drill" "log_scan:26:the nightly log scan"; do
  kind="${job%%:*}"; rest="${job#*:}"; hours="${rest%%:*}"; what="${rest#*:}"
  last="$(ops_last "$kind")"
  if [[ "$last" == none* ]]; then
    warn "$what has never run yet (the nightly job in README, «Nightly job»)"
  else
    check "the last run of $what worked" bash -c "[[ '${last%%|*}' == 'true' ]]"
    ago="${last##*|}"
    check "$what worked within the last $hours hours" bash -c "[[ $ago -ge 0 && $ago -lt $hours ]]"
  fi
done
if curl -fsS -m 5 http://edge:8081/healthz >/dev/null 2>&1; then
  # n8n answers it (its own JSON, a 404 too while META-WA-INBOUND is inactive), never the edge's own HTML 404.
  check "the edge lets Meta's WhatsApp webhook through to n8n" \
    bash -c 'b="$(curl -s -m 10 "http://edge:8081/webhook/3c1f0b6e-6a52-4f0e-9a51-0e0c0a5ea001/webhook")"; [[ -n "$b" && "$b" != *"<html>"* ]]'
  check "the edge hides n8n's login page and API (404)" \
    bash -c '[[ "$(curl -s -o /dev/null -w "%{http_code}" -m 10 http://edge:8081/rest/login)" == "404" && "$(curl -s -o /dev/null -w "%{http_code}" -m 10 http://edge:8081/)" == "404" ]]'
  check "the edge hides the internal send webhook (404)" \
    bash -c '[[ "$(curl -s -o /dev/null -w "%{http_code}" -m 10 -X POST http://edge:8081/webhook/hazem-internal-send)" == "404" ]]'
else
  echo "SKIP  the edge is not running (no tunnel up): its checks run when the tunnel is up"
fi

echo "== The WAHA test channel (TASK 02b, DECISIONS v1.19 T-03)"
provider="$(psql_super office -c "SELECT value FROM app.settings WHERE key = 'whatsapp.provider'")"
check "the WhatsApp channel is meta or waha" test "$provider" = meta -o "$provider" = waha
check "WAHA's address is inside the Docker network (waha.base_url)" \
  sql_equals office "SELECT value FROM app.settings WHERE key = 'waha.base_url'" "http://waha:3000"
if [[ "$provider" == waha ]]; then
  warn "the WhatsApp channel is WAHA (the test channel, a spare number only): switch back to meta before any real client (docs/runbooks/waha.md)"
  if [[ -n "${WAHA_API_KEY:-}" ]]; then
    state="$(curl -s -m 5 -H @<(printf 'X-Api-Key: %s\n' "$WAHA_API_KEY") http://waha:3000/api/sessions/default 2>/dev/null | jq -r '.status // "none"' 2>/dev/null || echo none)"
    [[ "$state" == WORKING ]] || warn "WAHA's session is '${state:-none}', not WORKING: nothing reaches WhatsApp (tools waha-session, scan the QR code)"
  else
    warn "the channel is WAHA but WAHA_API_KEY is empty in .env: nothing can be sent"
  fi
fi

echo "== Migrations"
check "migration 0021 (the WAHA test channel) is applied" \
  sql_equals office "SELECT count(*) FROM public.schema_migrations WHERE version = '0021'" "1"
check "migration 0018 (the prices and the office's questions) is applied" \
  sql_equals office "SELECT count(*) FROM public.schema_migrations WHERE version = '0018'" "1"
check "migration 0017 (the reminders) is applied" \
  sql_equals office "SELECT count(*) FROM public.schema_migrations WHERE version = '0017'" "1"
check "migration 0016 (the Urfi cases) is applied" \
  sql_equals office "SELECT count(*) FROM public.schema_migrations WHERE version = '0016'" "1"
check "migration 0015 (the written services) is applied" \
  sql_equals office "SELECT count(*) FROM public.schema_migrations WHERE version = '0015'" "1"
check "migration 0014 (the payments, the hold until the receipt) is applied" \
  sql_equals office "SELECT count(*) FROM public.schema_migrations WHERE version = '0014'" "1"
check "migration 0013 (the booking) is applied" \
  sql_equals office "SELECT count(*) FROM public.schema_migrations WHERE version = '0013'" "1"
check "migration 0009 (panel accounts) is applied"   sql_equals office "SELECT count(*) FROM public.schema_migrations WHERE version = '0009'" "1"
check "migration 0008 (lists, staff tasks, sources, topics) is applied" \
  sql_equals office "SELECT count(*) FROM public.schema_migrations WHERE version = '0008'" "1"
check "migration 0007 (owner-approved texts) is applied" \
  sql_equals office "SELECT count(*) FROM public.schema_migrations WHERE version = '0007'" "1"
check "migration 0006 (sends only to test recipients) is applied" \
  sql_equals office "SELECT count(*) FROM public.schema_migrations WHERE version = '0006'" "1"
check "migration 0005 (Hazem conversations, texts, classifications) is applied" \
  sql_equals office "SELECT count(*) FROM public.schema_migrations WHERE version = '0005'" "1"
check "migration 0004 (grouping, media, voice) is applied" \
  sql_equals office "SELECT count(*) FROM public.schema_migrations WHERE version = '0004'" "1"
check "migration 0003 (API schema hazem) is applied" \
  sql_equals office "SELECT count(*) FROM public.schema_migrations WHERE version = '0003'" "1"
check "migration 0002 (WhatsApp) is applied" \
  sql_equals office "SELECT count(*) FROM public.schema_migrations WHERE version = '0002'" "1"
check "migration 0001 is applied" \
  sql_equals office "SELECT count(*) FROM public.schema_migrations WHERE version = '0001'" "1"
check "schema app exists" \
  sql_equals office "SELECT count(*) FROM pg_namespace WHERE nspname = 'app'" "1"
check "function app.set_updated_at() exists" \
  sql_equals office "SELECT count(*) FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace WHERE n.nspname = 'app' AND p.proname = 'set_updated_at'" "1"

echo
echo "Result: $passed passed, $failed failed.$([[ $warned -gt 0 ]] && echo " $warned warning(s).")"
# TASK 13: recorded, so a failed healthcheck reaches the managers (the bell and an e-mail).
run="$(ops_start healthcheck 2>/dev/null || true)"
ops_finish "$run" "$([[ $failed -eq 0 ]] && echo true || echo false)" NULL "$passed" "$([[ $failed -gt 0 ]] && echo "failed:$failed")" 2>/dev/null || true
[[ $failed -eq 0 ]]
