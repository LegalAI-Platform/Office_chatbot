#!/bin/bash
# Blocks the stack from starting with placeholder or weak configuration.
set -uo pipefail

fail=0
err() { echo "PREFLIGHT FAIL: $*" >&2; fail=1; }

required=(
  ENVIRONMENT
  POSTGRES_SUPERUSER POSTGRES_SUPERUSER_PASSWORD
  N8N_DB_PASSWORD OFFICE_MIGRATOR_PASSWORD OFFICE_APP_PASSWORD OFFICE_READONLY_PASSWORD OFFICE_API_PASSWORD
  REDIS_PASSWORD
  GARAGE_RPC_SECRET GARAGE_ADMIN_TOKEN S3_REGION
  S3_N8N_ACCESS_KEY_ID S3_N8N_SECRET_ACCESS_KEY
  S3_BACKUP_ACCESS_KEY_ID S3_BACKUP_SECRET_ACCESS_KEY
  S3_API_ACCESS_KEY_ID S3_API_SECRET_ACCESS_KEY
  N8N_ENCRYPTION_KEY N8N_HOST N8N_PROTOCOL WEBHOOK_URL
  HAZEM_API_TOKEN N8N_INTERNAL_SEND_TOKEN
  CHATWOOT_SECRET_KEY_BASE CHATWOOT_DB_PASSWORD CHATWOOT_REDIS_PASSWORD
  CHATWOOT_PLATFORM_TOKEN CHATWOOT_BOT_TOKEN CHATWOOT_WEBHOOK_TOKEN
  BACKUP_ENCRYPTION_KEY
)

for v in "${required[@]}"; do
  val="${!v:-}"
  if [[ -z "$val" ]]; then
    err "$v is empty"
  elif [[ "$val" == *CHANGE_ME* ]]; then
    err "$v still contains CHANGE_ME"
  fi
done

case "${ENVIRONMENT:-}" in
  test|staging) ;;
  *) err "ENVIRONMENT must be 'test' or 'staging' for this stack (got '${ENVIRONMENT:-}')" ;;
esac

for v in POSTGRES_SUPERUSER_PASSWORD N8N_DB_PASSWORD OFFICE_MIGRATOR_PASSWORD \
         OFFICE_APP_PASSWORD OFFICE_READONLY_PASSWORD OFFICE_API_PASSWORD REDIS_PASSWORD GARAGE_ADMIN_TOKEN; do
  val="${!v:-}"
  [[ -n "$val" && ${#val} -lt 24 ]] && err "$v must be at least 24 characters"
done

# Passwords are embedded in connection URLs; keep them URL-safe.
for v in N8N_DB_PASSWORD OFFICE_MIGRATOR_PASSWORD OFFICE_APP_PASSWORD OFFICE_READONLY_PASSWORD OFFICE_API_PASSWORD; do
  val="${!v:-}"
  [[ -n "$val" && ! "$val" =~ ^[A-Za-z0-9_-]+$ ]] && err "$v may only contain letters, digits, '_' and '-'"
done

[[ "${N8N_ENCRYPTION_KEY:-}" =~ ^.{32,}$ ]] || err "N8N_ENCRYPTION_KEY must be at least 32 characters"
# n8n <-> .NET API (DECISIONS v1.3, T-18): one secret per direction, header-safe characters.
for v in HAZEM_API_TOKEN N8N_INTERNAL_SEND_TOKEN; do
  [[ "${!v:-}" =~ ^[A-Za-z0-9_-]{32,}$ ]] || err "$v must be at least 32 letters, digits, '_' or '-'"
done
[[ "${HAZEM_API_TOKEN:-}" != "${N8N_INTERNAL_SEND_TOKEN:-}" ]] || err "HAZEM_API_TOKEN and N8N_INTERNAL_SEND_TOKEN must be different"
# TASK 04: the .NET OpenAI key may be empty (classification off); when set it must be a real value.
if [[ -n "${HAZEM_OPENAI_API_KEY:-}" ]]; then
  [[ "$HAZEM_OPENAI_API_KEY" == *CHANGE_ME* ]] && err "HAZEM_OPENAI_API_KEY still contains CHANGE_ME"
  [[ "$HAZEM_OPENAI_API_KEY" =~ ^[A-Za-z0-9_-]{20,}$ ]] || err "HAZEM_OPENAI_API_KEY must be at least 20 letters, digits, '_' or '-'"
fi
[[ -z "${OPENAI_BASE_URL:-}" || "$OPENAI_BASE_URL" =~ ^https?://[^[:space:]]+$ ]] || err "OPENAI_BASE_URL must be an http(s) URL"
# TASK 07b (T-24): Chatwoot's own secrets, and the tokens .NET and Chatwoot use with each other.
for v in CHATWOOT_SECRET_KEY_BASE CHATWOOT_DB_PASSWORD CHATWOOT_REDIS_PASSWORD \
         CHATWOOT_PLATFORM_TOKEN CHATWOOT_BOT_TOKEN CHATWOOT_WEBHOOK_TOKEN; do
  [[ "${!v:-}" =~ ^[A-Za-z0-9_-]{24,}$ ]] || err "$v must be at least 24 letters, digits, '_' or '-'"
done
[[ "${GARAGE_RPC_SECRET:-}" =~ ^[0-9a-f]{64}$ ]] || err "GARAGE_RPC_SECRET must be exactly 64 lowercase hex characters"

for v in S3_N8N_ACCESS_KEY_ID S3_BACKUP_ACCESS_KEY_ID S3_API_ACCESS_KEY_ID; do
  [[ "${!v:-}" =~ ^GK[0-9a-f]{24}$ ]] || err "$v must be 'GK' followed by 24 lowercase hex characters"
done
for v in S3_N8N_SECRET_ACCESS_KEY S3_BACKUP_SECRET_ACCESS_KEY S3_API_SECRET_ACCESS_KEY; do
  [[ "${!v:-}" =~ ^[0-9a-f]{64}$ ]] || err "$v must be exactly 64 lowercase hex characters"
done
[[ "${S3_N8N_ACCESS_KEY_ID:-}" != "${S3_BACKUP_ACCESS_KEY_ID:-}" ]] || err "n8n and backup S3 keys must be different"
# TASK 02b: the WAHA test channel's keys are optional; when one is set, all three are, strong and distinct.
if [[ -n "${WAHA_API_KEY:-}${WAHA_WEBHOOK_TOKEN:-}${WAHA_DASHBOARD_PASSWORD:-}" ]]; then
  for v in WAHA_API_KEY WAHA_WEBHOOK_TOKEN; do
    [[ "${!v:-}" =~ ^[A-Za-z0-9_-]{32,}$ ]] || err "$v must be at least 32 letters, digits, '_' or '-' (gen-secrets)"
  done
  [[ "${WAHA_DASHBOARD_PASSWORD:-}" =~ ^[A-Za-z0-9_-]{16,}$ ]] || err "WAHA_DASHBOARD_PASSWORD must be at least 16 letters, digits, '_' or '-' (gen-secrets)"
  [[ "${WAHA_API_KEY:-}" != "${WAHA_WEBHOOK_TOKEN:-}" ]] || err "WAHA_API_KEY and WAHA_WEBHOOK_TOKEN must be different"
fi
# TASK 13: every backup is encrypted with it (and nothing can be read back without it).
[[ "${BACKUP_ENCRYPTION_KEY:-}" =~ ^[0-9a-f]{64}$ ]] || err "BACKUP_ENCRYPTION_KEY must be exactly 64 lowercase hex characters (gen-secrets)"
[[ "${S3_API_ACCESS_KEY_ID:-}" != "${S3_N8N_ACCESS_KEY_ID:-}" && "${S3_API_ACCESS_KEY_ID:-}" != "${S3_BACKUP_ACCESS_KEY_ID:-}" ]] \
  || err "the api's S3 key must be its own"

if [[ $fail -ne 0 ]]; then
  echo "Preflight failed. Fix .env (see .env.example and docs/env-variables.md)." >&2
  exit 1
fi
echo "Preflight OK (ENVIRONMENT=${ENVIRONMENT})."
