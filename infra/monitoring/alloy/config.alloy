// Alloy (v1.107, docs/runbooks/monitoring.md): the logs of this compose project's containers, masked (mask.alloy), to Loki.
// Docker is reached through docker-proxy, which answers reads only; Alloy never has Docker's socket.
logging {
  level  = "warn"
  format = "logfmt"
}

import.file "mask" {
  filename = "/etc/alloy/mask.alloy"
}

// The containers of this project (COMPOSE_PROJECT_NAME, "office"), one-off runs (tools, migrate) included.
discovery.docker "containers" {
  host             = "tcp://docker-proxy:2375"
  refresh_interval = "15s"

  filter {
    name   = "label"
    values = ["com.docker.compose.project=" + sys.env("COMPOSE_PROJECT_NAME")]
  }
}

// Each stream is known by its compose service (api, n8n, postgres…), its container and stdout/stderr.
discovery.relabel "containers" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }
}

loki.source.docker "containers" {
  host          = "tcp://docker-proxy:2375"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.process.recent.receiver]
}

// On a first start Docker hands over each container's whole log, and a one-shot container started again (chatwoot-init,
// storage-init, preflight, monitoring-init: every deploy, every rollback) hands over its earlier runs' lines too. Loki
// refuses a line more than an hour behind its stream's newest («entry too far behind»), and Alloy counts it dropped, which
// failed the healthcheck's «the logs reach Loki» after two deploys within an hour (v1.115, 2026-11-14). So only the last
// 50 minutes go (Docker keeps the rest; `docker compose logs` reads it). This drop is counted apart, in
// loki_process_dropped_lines_total{reason="older_than_50m"}, never as a line Loki lost.
loki.process "recent" {
  stage.drop {
    older_than          = "50m"
    drop_counter_reason = "older_than_50m"
  }

  forward_to = [mask.mask.logs.receiver]
}

mask.mask "logs" {
  forward_to = [loki.write.loki.receiver]
}

loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
