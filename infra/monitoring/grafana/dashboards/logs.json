        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service=~\"$service\"} [1h]))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "A"
