    {
      "type": "stat",
      "title": "Lines with a number (24h)",
      "description": "Masked before Loki, but Docker keeps the line: the night's log-scan fails (LogsHavePhoneNumber).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(increase(loki_process_custom_log_lines_with_phone_total[24h]) and loki_process_custom_log_lines_with_phone_total offset 24h) or vector(0)) + (sum(loki_process_custom_log_lines_with_phone_total unless loki_process_custom_log_lines_with_phone_total offset 24h) or vector(0))",
          "legendFormat": "__auto",
          "range": true,
