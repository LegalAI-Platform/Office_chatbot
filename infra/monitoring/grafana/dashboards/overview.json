  "panels": [
    {
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "**أخضر** = شغال، **أحمر** = واقف. التنبيهات بتوصل بالإيميل (Alertmanager)، وتنبيهات البيزنس والشغلانة الليلية فضلت في جرس البانل. اعمل إيه في كل تنبيه: `docs/runbooks/monitoring.md`."
      },
      "transparent": true,
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      }
    },
    {
      "type": "stat",
      "title": "الخدمات",
      "description": "كل خدمة بالفحص بتاعها: صفحة الصحة من جوه، والداتابيز وRedis من الـ exporters، وwa. والصفحة الرئيسية من برّه عن طريق Cloudflare.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "probe_success{job=\"probe\",service=\"api\"}",
          "refId": "A",
          "legendFormat": "حازم (API)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "probe_success{job=\"probe\",service=\"web\"}",
          "refId": "B",
          "legendFormat": "البانل"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "probe_success{job=\"probe\",service=\"n8n\"}",
          "refId": "C",
          "legendFormat": "n8n"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "probe_success{job=\"probe\",service=\"chatwoot\"}",
          "refId": "D",
          "legendFormat": "Chatwoot"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "clamp_max(max(redis_key_size{cluster=\"chatwoot\",key=\"processes\"}), 1)",
          "refId": "E",
          "legendFormat": "Sidekiq"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "probe_success{job=\"probe\",service=\"garage\"}",
          "refId": "F",
          "legendFormat": "التخزين"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "pg_up{cluster=\"office\"}",
          "refId": "G",
          "legendFormat": "داتابيز المكتب"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "pg_up{cluster=\"chatwoot\"}",
          "refId": "H",
          "legendFormat": "داتابيز Chatwoot"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "redis_up{cluster=\"office\"}",
          "refId": "I",
          "legendFormat": "Redis المكتب"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "redis_up{cluster=\"chatwoot\"}",
          "refId": "J",
          "legendFormat": "Redis Chatwoot"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "probe_success{job=\"probe_public\",service=\"edge\"}",
          "refId": "K",
          "legendFormat": "واتساب من برّه (wa.)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "probe_success{job=\"probe_public\",service=\"web\"}",
          "refId": "L",
          "legendFormat": "صفحة المكتب من برّه"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "مفيش بيانات",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "واقف",
