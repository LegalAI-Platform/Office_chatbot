          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"api\",http_route!=\"/api/panel/alerts/stream\",http_route!=\"/api/hazem/turns\"}[$__rate_interval])))",
