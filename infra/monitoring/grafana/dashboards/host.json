    {
      "type": "table",
      "title": "حالة كل container",
      "description": "الحالة من Docker، والـ healthcheck بتاعه، وكام مرة قام تاني في 24 ساعة.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (service, container_status) (docker_container_status_exitcode{oneoff=\"False\"})",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (service, health_status) (docker_container_health_failing_streak{oneoff=\"False\"})",
          "refId": "B",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (service) (increase(docker_container_status_restart_count{oneoff=\"False\"}[24h]))",
          "refId": "C",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "service": "الخدمة",
              "container_status": "الحالة",
              "health_status": "الـ healthcheck",
              "Value #A": "exit code",
              "Value #B": "فشل ورا بعض",
              "Value #C": "restarts (24 ساعة)"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
