    {
      "type": "table",
      "title": "Containers",
      "description": "Every container of the project: Docker's state and healthcheck, restarts in 24 hours, CPU (100% = one CPU), memory, and memory of its limit.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (service, container_status) (docker_container_status_exitcode{oneoff=\"False\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (service, health_status) (docker_container_health_failing_streak{oneoff=\"False\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (service) (increase(docker_container_status_restart_count{oneoff=\"False\"}[24h]))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service) (docker_container_cpu_usage_percent{container_status=\"running\",oneoff=\"False\",cpu=\"cpu-total\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service) (docker_container_mem_usage{container_status=\"running\",oneoff=\"False\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (service) (docker_container_mem_usage_percent{container_status=\"running\",oneoff=\"False\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "refId": "F"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": true,
              "Value #B": true
            },
            "indexByName": {
              "service": 0,
              "container_status": 1,
              "health_status": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6
            },
            "renameByName": {
              "service": "Service",
              "container_status": "State",
              "health_status": "Health",
              "Value #C": "Restarts (24h)",
              "Value #D": "CPU",
              "Value #E": "Memory",
              "Value #F": "Memory of limit"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
