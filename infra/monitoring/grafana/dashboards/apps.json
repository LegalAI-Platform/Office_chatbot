          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "semi-dark-red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "semi-dark-green",
                  "index": 1
