    {
      "parameters": {
        "jsCode": "// WhatsApp voice notes are audio/ogg; codecs=opus: send them as audio/ogg named .ogg.\n// audio/mp3 is sent as audio/mpeg. Anything that is not audio never gets here (T-09).\nconst item = $input.first();\nif (!item.binary || !item.binary.data) return [{ json: { no_audio: true } }];\nconst base = String(item.binary.data.mimeType || '').split(';')[0].trim().toLowerCase();\nif (!base.startsWith('audio/')) return [{ json: { no_audio: true } }];\nconst map = { 'audio/ogg': ['audio/ogg', 'ogg'], 'audio/mp3': ['audio/mpeg', 'mp3'], 'audio/mpeg': ['audio/mpeg', 'mp3'],\n  'audio/mp4': ['audio/mp4', 'm4a'], 'audio/aac': ['audio/aac', 'aac'], 'audio/amr': ['audio/amr', 'amr'] };\nconst [mime, ext] = map[base] || [base, 'ogg'];\nitem.binary.data.mimeType = mime;\nitem.binary.data.fileName = 'voice.' + ext;\nitem.binary.data.fileExtension = ext;\nreturn [item];"
      },
