      "parameters": {
        "jsCode": "// The file's place on WAHA: only a path under /api/files, joined to waha.base_url (never an address from the event),\n// and its size from WAHA (HEAD), so wa_media_precheck applies whatsapp.media_max_mb as for Meta.\nconst path = String($('Start').first().json.meta_media_id || '').replace(/^waha:/, '');\nconst base = String($('Settings').first().json.cfg['waha.base_url'] || '').replace(/\\/+$/, '');\nconst ok = /^\\/api\\/files\\/[A-Za-z0-9._@=\\/-]+$/.test(path) && !path.includes('..');\nconst headers = $('File size').first().json.headers || {};\nconst size = Number(headers['content-length']);\nconst info = { url: base + path };\nif (Number.isFinite(size) && size > 0) info.file_size = size;\nreturn [{ json: ok ? { statusCode: 200, body: info } : { statusCode: 404, body: { error: 'no WAHA file' } } }];"
      },
