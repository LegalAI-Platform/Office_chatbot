{
  "name": "WAHA-INBOUND",
  "nodes": [
    {
      "parameters": {
        "content": "## WAHA-INBOUND (TASK 02b)\nThe WAHA test channel's webhook (`message`, `message.ack`), signed with `X-Waha-Token` (`waha-webhook`). Heard only while `whatsapp.provider` = `waha` and for its own session. A sender that comes as a LID (`…@lid`) is turned into the phone number by WAHA (`/api/{session}/lids/{lid}`); unknown → dropped. `app.waha_event` makes it Meta's event (a reply «1» to a numbered list = that button), then the same steps as META-WA-INBOUND: process, media, quiet period, forward turns.",
        "height": 260,
        "width": 720
      },
      "id": "cbf69d15-3f1a-58eb-ab20-595bc1783dc8",
      "name": "Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        160,
        40
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "waha-inbound",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "8cca477e-253b-5e9a-a8ed-6327e436ed28",
      "name": "WAHA webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        360
      ],
      "webhookId": "c6c57294-5eab-5488-9dee-dd58163f9938",
      "credentials": {
        "httpHeaderAuth": {
          "id": "CRED:waha-webhook",
          "name": "waha-webhook"
        }
      }
    },
    {
      "id": "e2479428-ca1e-50d1-9c4f-5944271c51bf",
      "name": "Settings",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        480,
        360
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COALESCE(max(value) FILTER (WHERE key = 'whatsapp.provider'), 'meta') AS provider, max(value) FILTER (WHERE key = 'waha.base_url') AS base_url, max(value) FILTER (WHERE key = 'waha.session') AS session FROM app.settings WHERE key IN ('whatsapp.provider', 'waha.base_url', 'waha.session')",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "CRED:office-postgres-app",
          "name": "office-postgres-app"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "eba12571-07b3-5c9b-a159-4f13b3e595d6",
              "leftValue": "={{ $json.provider === 'waha' && ($('WAHA webhook').first().json.body || {}).session === $json.session }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "a67220bd-81c2-5d3d-b886-bbe0f31cace4",
      "name": "WAHA on?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        720,
        360
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c5401de5-f06e-5e89-b104-a72927f6005f",
              "leftValue": "={{ ($('WAHA webhook').first().json.body || {}).event === 'message' && String((($('WAHA webhook').first().json.body || {}).payload || {}).from || '').endsWith('@lid') }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "2e648e22-21cd-5dc1-aec5-587a49d54f2d",
      "name": "LID?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        960,
        360
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ String($('Settings').first().json.base_url || '').replace(/\\/+$/, '') }}/api/{{ encodeURIComponent($('Settings').first().json.session) }}/lids/{{ encodeURIComponent($('WAHA webhook').first().json.body.payload.from) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 20000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "c76d5646-f2fd-5cbb-9707-b07f635a00da",
