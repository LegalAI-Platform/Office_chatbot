      ],
      "parameters": {
        "content": "## META-WA-INBOUND\nWhatsApp Trigger: verifies X-Hub-Signature-256 with the App Secret (credential meta-whatsapp-trigger), answers Meta's verification, and registers the webhook subscription on activation. Kept thin: every event goes to META-WA-PROCESS-EVENT, then WA-MEDIA-FETCH downloads new media at once (Meta's URLs expire), waits whatsapp.group_quiet_seconds + 1 s, and WA-FORWARD-TURN hands the grouped turn to the API.\nOnly ONE trigger per Meta App. After the tunnel URL changes run scripts/*/tunnel-refresh.",
        "height": 220,
        "width": 520
      }
    },
    {
      "id": "1f9ff900-b947-5d7b-acee-d6afa0114998",
      "name": "WhatsApp Trigger",
      "type": "n8n-nodes-base.whatsAppTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "parameters": {
        "updates": [
          "messages",
          "message_template_status_update"
        ],
        "options": {
          "messageStatusUpdates": [
            "all"
          ]
        }
      },
      "credentials": {
        "whatsAppTriggerApi": {
          "id": "CRED:meta-whatsapp-trigger",
          "name": "meta-whatsapp-trigger"
        }
      },
      "webhookId": "3c1f0b6e-6a52-4f0e-9a51-0e0c0a5ea001"
    },
    {
