          },
          "conditions": [
            {
              "id": "8169b12e-0370-5455-9ab0-7723e2d1f458",
              "leftValue": "={{ /^([0-9]{8,15}|[A-Z]{2}[.][A-Za-z0-9.]{1,140})$/.test(String($json.wa_id || '')) && typeof $json.text === 'string' && $json.text.trim().length > 0 && $json.text.length <= 4096 && !!$json.idempotency_key && !!$json.requested_by && (() => { const i = $json.interactive ? (typeof $json.interactive === 'string' ? JSON.parse($json.interactive) : $json.interactive) : null; if (!i) return true; const list = i.kind === 'list'; const max = list ? 24 : 20; return (i.kind === 'buttons' || list) && $json.text.length <= 1024 && Array.isArray(i.choices) && i.choices.length >= 1 && i.choices.length <= (list ? 10 : 3) && i.choices.every((c) => c && typeof c.id === 'string' && c.id.length >= 1 && c.id.length <= 200 && typeof c.title === 'string' && c.title.length >= 1 && c.title.length <= max) && (!list || (typeof i.button === 'string' && i.button.length >= 1 && i.button.length <= 20)); })() && (() => { const d = $json.document ? (typeof $json.document === 'string' ? JSON.parse($json.document) : $json.document) : null; if (!d) return true; return !$json.interactive && $json.text.length <= 1024 && typeof d.link === 'string' && (d.link.startsWith('https://') || d.link.startsWith('http://')) && d.link.length <= 4000 && typeof d.filename === 'string' && d.filename.length >= 1 && d.filename.length <= 240; })() }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
