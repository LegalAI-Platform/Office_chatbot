        "jsonOutput": "{\"templates\": [{\"name\": \"reminder_day_before\", \"language\": \"ar\", \"category\": \"UTILITY\", \"components\": [{\"type\": \"BODY\", \"text\": \"تذكير بميعاد حضرتك مع الأستاذ سعد بكرة {{1}} الساعة {{2}}. نوع الاستشارة: {{3}}. التفاصيل: {{4}}. من فضلك أكّد حضورك بالزرار تحت.\", \"example\": {\"body_text\": [[\"الثلاثاء 21 أكتوبر\", \"6 مساءً\", \"مقابلة في المكتب\", \"المكتب في الدقي، والعنوان على الخريطة\"]]}}, {\"type\": \"BUTTONS\", \"buttons\": [{\"type\": \"QUICK_REPLY\", \"text\": \"هحضر ✅\"}, {\"type\": \"QUICK_REPLY\", \"text\": \"تغيير أو إلغاء\"}]}]}, {\"name\": \"reminder_2h_before\", \"language\": \"ar\", \"category\": \"UTILITY\", \"components\": [{\"type\": \"BODY\", \"text\": \"ميعاد حضرتك مع الأستاذ سعد النهارده الساعة {{1}}. نوع الاستشارة: {{2}}. التفاصيل: {{3}}. في انتظار حضرتك.\", \"example\": {\"body_text\": [[\"6 مساءً\", \"استشارة بالتليفون\", \"الأستاذ هيكلم حضرتك على نفس الرقم\"]]}}]}, {\"name\": \"staff_delay_apology\", \"language\": \"ar\", \"category\": \"UTILITY\", \"components\": [{\"type\": \"BODY\", \"text\": \"معلش اتأخرنا على حضرتك، هنكلمك خلال دقايق.\"}]}, {\"name\": \"booking_confirmed\", \"language\": \"ar\", \"category\": \"UTILITY\", \"components\": [{\"type\": \"BODY\", \"text\": \"تم حجز ميعاد حضرتك يوم {{1}} الساعة {{2}} ✅. التفاصيل: {{3}}. لو محتاج أي حاجة ابعتلنا هنا.\", \"example\": {\"body_text\": [[\"الثلاثاء 21 أكتوبر\", \"6 مساءً\", \"استشارة بالتليفون، والأستاذ هيكلم حضرتك\"]]}}]}, {\"name\": \"payment_reminder\", \"language\": \"ar\", \"category\": \"UTILITY\", \"components\": [{\"type\": \"BODY\", \"text\": \"ميعاد حضرتك {{1}} الساعة {{2}}. مستنيين صورة تحويل {{3}} جنيه على {{4}}. بعد التحويل ابعتلنا الصورة هنا.\", \"example\": {\"body_text\": [[\"الثلاثاء 21 أكتوبر\", \"6 مساءً\", \"500\", \"InstaPay\"]]}}]}, {\"name\": \"booking_cancelled_by_office\", \"language\": \"ar\", \"category\": \"UTILITY\", \"components\": [{\"type\": \"BODY\", \"text\": \"نعتذر لحضرتك، الأستاذ عنده ظرف في ميعاد {{1}}. تحب ميعاد تاني ولا استرداد كامل؟\", \"example\": {\"body_text\": [[\"الثلاثاء 21 أكتوبر الساعة 6 مساءً\"]]}}]}, {\"name\": \"payment_partial\", \"language\": \"ar\", \"category\": \"UTILITY\", \"components\": [{\"type\": \"BODY\", \"text\": \"وصلنا {{1}} جنيه من {{2}}. محتاجين باقي المبلغ {{3}} جنيه عشان نأكد الخدمة.\", \"example\": {\"body_text\": [[\"300\", \"500\", \"200\"]]}}]}, {\"name\": \"payment_not_received\", \"language\": \"ar\", \"category\": \"UTILITY\", \"components\": [{\"type\": \"BODY\", \"text\": \"التحويل الخاص بميعاد {{1}} ما وصلش. ممكن تبعت صورة التحويل أو تكلمنا على {{2}} في مواعيد العمل.\", \"example\": {\"body_text\": [[\"الثلاثاء 21 أكتوبر الساعة 6 مساءً\", \"01000000000\"]]}}]}, {\"name\": \"refund_completed\", \"language\": \"ar\", \"category\": \"UTILITY\", \"components\": [{\"type\": \"BODY\", \"text\": \"تم رد مبلغ {{1}} جنيه لحضرتك على {{2}}. شكرًا لحضرتك.\", \"example\": {\"body_text\": [[\"500\", \"InstaPay\"]]}}]}, {\"name\": \"service_ready\", \"language\": \"ar\", \"category\": \"UTILITY\", \"components\": [{\"type\": \"BODY\", \"text\": \"الخدمة المطلوبة ({{1}}) جاهزة، وهتوصل حضرتك هنا حالًا.\", \"example\": {\"body_text\": [[\"مراجعة العقد\"]]}}]}]}",
