    {
      "id": "a4298a09-4b9b-58a6-aa31-13e42bba3d7f",
      "name": "Upsert template",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        2400,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO app.wa_templates (name, language, category, status, meta_template_id, components, rejection_reason, last_synced_at)\nVALUES ($1, $2, $3, $4, $5, $6::jsonb, NULLIF($7, 'NONE'), now())\nON CONFLICT (name, language) DO UPDATE SET category = EXCLUDED.category, status = EXCLUDED.status,\n  meta_template_id = EXCLUDED.meta_template_id, components = EXCLUDED.components,\n  rejection_reason = EXCLUDED.rejection_reason, last_synced_at = now()\nRETURNING name, language, category, status, rejection_reason",
        "options": {
          "queryReplacement": "={{ [ $json.name, $json.language, $json.category, $json.status, $json.id, JSON.stringify($json.components || []), $json.rejected_reason || 'NONE' ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "CRED:office-postgres-app",
          "name": "office-postgres-app"
        }
      }
    }
