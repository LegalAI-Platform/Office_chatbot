            {
              "name": "limit",
              "value": "200"
            }
          ]
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CRED:meta-whatsapp-token",
          "name": "meta-whatsapp-token"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
