        "options": {
          "queryReplacement": "={{ [ $('Start').first().json.turn_id, JSON.stringify({ code: 'API_UNAVAILABLE', http_status: $('Ask the API').first().json.statusCode || null }) ] }}"
        }
      },
      "id": "fc13c252-25bb-5290-885f-08fd1233fc7c",
      "name": "Give back",
