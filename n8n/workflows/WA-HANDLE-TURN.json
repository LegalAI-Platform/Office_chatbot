{
  "name": "WA-HANDLE-TURN",
  "nodes": [
    {
      "parameters": {
        "content": "## WA-HANDLE-TURN\nOne turn (from `app.wa_turns_claim`): POST /api/hazem/turns → send every action through WA-SEND-ACTION → POST /api/hazem/send-results → `app.wa_turns_finish(processed)`.\nAPI down / 5xx / 401 / 403 → messages go back to `pending` (retried next minute). 400 / 422 → `failed`. Contract: docs/hazem-internal-api.md.",
        "height": 260,
        "width": 520
      },
      "id": "e1d39775-cd7f-5e62-ba31-8a2d3be5e03a",
      "name": "Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "ee4cbb68-bc82-5f9f-bdbe-1b6e4bae35f6",
      "name": "Start",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.3,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8080/api/hazem/turns",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "1ab9afc4-e98a-538a-abae-18ba196ca09d",
      "name": "Ask the API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        480,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CRED:hazem-api",
          "name": "hazem-api"
        }
      },
      "retryOnFail": false,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "45e3448e-4be6-574f-aba1-1c940ce9415d",
              "leftValue": "={{ $json.statusCode >= 200 && $json.statusCode < 300 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "575bd774-41a1-55c9-be74-a66756ce1b1c",
      "name": "API answered?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// One item per action; a marker item when there is nothing to send.\nconst turn = $('Start').first().json;\nconst body = $input.first().json.body || {};\nconst actions = Array.isArray(body.actions) ? body.actions : [];\nif (actions.length === 0) return [{ json: { type: 'noop' } }];\nreturn actions.map((a) => ({ json: { ...a, wa_id: turn.wa_id, requested_by: 'hazem-api' } }));"
      },
      "id": "e720100e-3f86-5b0c-afe8-a17bbbed1ebf",
      "name": "Expand actions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        200
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "WaSendAction0001",
          "mode": "id",
          "cachedResultName": "WA-SEND-ACTION"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {},
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "4e3cd9a3-732a-5bed-bf7f-18ad12cde5df",
      "name": "Send action",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.4,
      "position": [
        1200,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const turn = $('Start').first().json;\nconst actions = $('Expand actions').all().map((i) => i.json);\nconst results = $input.all()\n  .map((item, i) => ({ action: actions[i], r: item.json }))\n  .filter((x) => x.action && x.action.type !== 'noop')\n  .map(({ action, r }) => ({\n    idempotency_key: action.idempotency_key, ok: r.ok === true,\n    outbound_id: r.outbound_id || null, wamid: r.wamid || null, status: r.status || null,\n    error_code: r.error_code || null, error_message: r.error_message || null }));\nreturn [{ json: { turn_id: turn.turn_id, wamids: turn.messages.map((m) => m.wamid), results } }];"
      },
      "id": "0547bc79-5bca-551e-b42a-f601d386045c",
      "name": "Summarize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8080/api/hazem/send-results",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ turn_id: $json.turn_id, results: $json.results }) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "74e96ff2-5cba-5da8-a2f2-206a4fa6bb2c",
      "name": "Report results",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1680,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CRED:hazem-api",
          "name": "hazem-api"
        }
      },
      "retryOnFail": false,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT app.wa_turns_finish($1, 'processed') AS finished",
        "options": {
          "queryReplacement": "={{ [ $('Summarize').first().json.turn_id ] }}"
        }
      },
      "id": "8bcf27fb-c916-5d80-a168-a29967334374",
      "name": "Mark processed",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1920,
        200
      ],
      "credentials": {
        "postgres": {
          "id": "CRED:office-postgres-app",
          "name": "office-postgres-app"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "bc89821c-9b84-5c1e-8250-43f2c2a50e56",
              "leftValue": "={{ [400, 422].includes($json.statusCode) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "d55c28c8-fa5c-5b44-8390-cf7650d86645",
      "name": "Bad request?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        960,
        480
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT app.wa_turns_finish($1, 'failed', $2::jsonb) AS finished",
        "options": {
          "queryReplacement": "={{ [ $('Start').first().json.turn_id, JSON.stringify({ code: 'API_REJECTED', http_status: $json.statusCode, body: $json.body }) ] }}"
        }
      },
      "id": "cda6ce33-f1bc-54a4-a536-5b9fbd09b6e2",
      "name": "Mark failed",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1200,
        400
      ],
      "credentials": {
        "postgres": {
          "id": "CRED:office-postgres-app",
          "name": "office-postgres-app"
        }
      }
    },
    {
      "parameters": {
        "errorMessage": "=The API rejected turn {{ $('Start').first().json.turn_id }} (HTTP {{ $('Bad request?').first().json.statusCode }}). The messages are marked failed."
      },
      "id": "122a2d7a-14b8-5b40-89fa-c1dd9edd73ce",
      "name": "Stop: API rejected the turn",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
