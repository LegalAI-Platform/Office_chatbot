# =====================================================================
# Office WhatsApp System (Hazem) - Test/Staging environment
# Copy to .env, then replace every CHANGE_ME value.
#   Generate values:  scripts/windows/gen-secrets.ps1  or  scripts/linux/gen-secrets.sh
# The stack refuses to start while any required value still contains CHANGE_ME.
# Full reference: docs/env-variables.md
# NEVER commit .env.
# =====================================================================

# --- General ---------------------------------------------------------
# Must be "test" or "staging". scripts/*/reset refuses to run unless "test".
# Also used as the ASP.NET Core environment name.
ENVIRONMENT=test
COMPOSE_PROJECT_NAME=office

# --- PostgreSQL 16 ---------------------------------------------------
# Superuser: used only by the init script, backup, restore and tests. Never by the API.
POSTGRES_SUPERUSER=postgres_admin
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Owner of the "office" database; used only by `cli migrate` (DDL).
OFFICE_MIGRATOR_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# office_app: SELECT/INSERT/UPDATE/DELETE only. Used by the API.
OFFICE_APP_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# office_readonly: SELECT only. Reports.
OFFICE_READONLY_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Redis 7 ---------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Object storage (Garage, S3-compatible) --------------------------
# 64 hex chars. Internal cluster RPC secret.
GARAGE_RPC_SECRET=CHANGE_ME_64_HEX_CHARS
# Bearer token for the Garage admin API (internal network only).
GARAGE_ADMIN_TOKEN=CHANGE_ME_STRONG_TOKEN
# S3 region name Garage answers to.
S3_REGION=garage
# app key (the backend, from TASK 03): read/write on office-media and office-sensitive only.
# Key ID format: GK + 24 hex chars. Secret: 64 hex chars.
S3_APP_ACCESS_KEY_ID=CHANGE_ME_GK_KEY_ID
S3_APP_SECRET_ACCESS_KEY=CHANGE_ME_64_HEX_CHARS
# Backup key: read/write/owner on office-backups only.
S3_BACKUP_ACCESS_KEY_ID=CHANGE_ME_GK_KEY_ID
S3_BACKUP_SECRET_ACCESS_KEY=CHANGE_ME_64_HEX_CHARS

# --- WhatsApp (Meta Cloud API) - see docs/meta-setup.md --------------
# false until every value below is filled. The API starts either way.
WhatsApp__Enabled=false
# Non-secret identifiers from the Meta App dashboard.
WhatsApp__AppId=
WhatsApp__WabaId=
WhatsApp__PhoneNumberId=
# Graph API version (checked against Meta's changelog).
WhatsApp__GraphApiVersion=v26.0
# Comma-separated wa_id list (digits only, no + or spaces) allowed to receive test messages.
WhatsApp__TestRecipients=
# Secrets: typed here by the project owner only, never shared in chat.
WhatsApp__AppSecret=
WhatsApp__AccessToken=
# Generated by gen-secrets.
WhatsApp__VerifyToken=
# Test-only auto reply ("تم استلام رسالتك (اختبار)"). Keep false except while testing.
WhatsApp__EchoTest__Enabled=false

# --- Operator alerts (optional, T-16) --------------------------------
Telegram__BotToken=
Telegram__ChatId=

# --- Cloudflare tunnel (optional) ------------------------------------
# Empty = Quick Tunnel profile ("tunnel"). Set = Named Tunnel ("tunnel-named").
CLOUDFLARE_TUNNEL_TOKEN=

# --- Future tasks: placeholders only ---------------------------------
# TASK 04 - OpenAI model name (decided after sample tests, T-08)
OPENAI_MODEL=
