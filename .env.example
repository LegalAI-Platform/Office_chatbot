# =====================================================================
# Office WhatsApp System (Hazem) - Test/Staging environment
# Copy to .env, then replace every CHANGE_ME value.
#   Generate values:  scripts/windows/gen-secrets.ps1  or  scripts/linux/gen-secrets.sh
# The stack refuses to start while any required value still contains CHANGE_ME.
# Full reference: docs/env-variables.md
# NEVER commit .env.
# =====================================================================

# --- General ---------------------------------------------------------
# Must be "test" or "staging". scripts/*/reset refuses to run unless "test".
ENVIRONMENT=test
COMPOSE_PROJECT_NAME=office

# --- PostgreSQL 16 ---------------------------------------------------
# Superuser: used only by the init script, backup and restore. Never by n8n or apps.
POSTGRES_SUPERUSER=postgres_admin
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Owner of the "n8n" database (n8n internal data). Cannot connect to "office".
N8N_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Owner of the "office" database; used only by the migration tool (DDL).
OFFICE_MIGRATOR_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# office_app: SELECT/INSERT/UPDATE/DELETE only. Used by n8n (TASK 02+) and Appsmith writes.
OFFICE_APP_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# office_readonly: SELECT only. Reports and Appsmith read views.
OFFICE_READONLY_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Redis 7 ---------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Object storage (Garage, S3-compatible) --------------------------
# 64 hex chars. Internal cluster RPC secret.
GARAGE_RPC_SECRET=CHANGE_ME_64_HEX_CHARS
# Bearer token for the Garage admin API (internal network only).
GARAGE_ADMIN_TOKEN=CHANGE_ME_STRONG_TOKEN
# S3 region name Garage answers to.
S3_REGION=garage
# n8n key: read/write on office-media and office-sensitive only.
# Key ID format: GK + 24 hex chars. Secret: 64 hex chars.
S3_N8N_ACCESS_KEY_ID=CHANGE_ME_GK_KEY_ID
S3_N8N_SECRET_ACCESS_KEY=CHANGE_ME_64_HEX_CHARS
# Backup key: read/write/owner on office-backups only.
S3_BACKUP_ACCESS_KEY_ID=CHANGE_ME_GK_KEY_ID
S3_BACKUP_SECRET_ACCESS_KEY=CHANGE_ME_64_HEX_CHARS

# --- n8n -------------------------------------------------------------
# 32+ random bytes (64 hex chars). If it changes or is lost, every stored
# n8n credential becomes unreadable. Back it up somewhere safe.
N8N_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS
# Local defaults. When the tunnel is used, set WEBHOOK_URL to the https URL
# (with trailing slash) and restart n8n.
N8N_HOST=127.0.0.1
N8N_PROTOCOL=http
WEBHOOK_URL=http://127.0.0.1:5678/
# 1 = trust one reverse proxy hop (cloudflared).
N8N_PROXY_HOPS=1
# false only because the local editor is plain http://127.0.0.1. Set true behind HTTPS.
N8N_SECURE_COOKIE=false
# Execution history retention, in hours (336 = 14 days).
EXECUTIONS_DATA_MAX_AGE=336

# --- Cloudflare tunnel (optional) ------------------------------------
# Empty = use the Quick Tunnel profile ("tunnel").
# Set it to use the Named Tunnel profile ("tunnel-named") with a stable hostname.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Future tasks: placeholders only, leave empty for now ------------
# TASK 02 - Meta WhatsApp Cloud API (non-secret identifiers)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
GRAPH_API_VERSION=
# TASK 04 - OpenAI model name (decided after sample tests, T-08)
OPENAI_MODEL=
# Monitoring (T-16) - Telegram chat that receives technical alerts
OPS_TELEGRAM_CHAT_ID=
#
# These secrets are NOT stored in .env. They go into n8n Credentials:
#   WHATSAPP_ACCESS_TOKEN, META_APP_SECRET, WHATSAPP_VERIFY_TOKEN (TASK 02)
#   OPENAI_API_KEY (TASK 04)
#   TELEGRAM_BOT_TOKEN (monitoring)
