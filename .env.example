# =====================================================================
# Office WhatsApp System (Hazem) - Test/Staging environment
# Copy to .env, then replace every CHANGE_ME value.
#   Generate values:  scripts/windows/gen-secrets.ps1  or  scripts/linux/gen-secrets.sh
# The stack refuses to start while any required value still contains CHANGE_ME.
# Full reference: docs/env-variables.md
# NEVER commit .env.
# =====================================================================

# --- General ---------------------------------------------------------
# Must be "test" or "staging". scripts/*/reset refuses to run unless "test".
ENVIRONMENT=test
COMPOSE_PROJECT_NAME=office

# The images of the API, the panel and the tools (docker-compose.yml). Empty: built on this machine (`:local`).
# On the server: the ones the CI published (.github/workflows/images.yml), never built there, e.g.
#   OFFICE_API_IMAGE=ghcr.io/legalai-platform/office-api:sha-1a2b3c4
#   OFFICE_WEB_IMAGE=ghcr.io/legalai-platform/office-web:sha-1a2b3c4
#   OFFICE_TOOLS_IMAGE=ghcr.io/legalai-platform/office-tools:sha-1a2b3c4
#   OFFICE_PULL_POLICY=missing
OFFICE_API_IMAGE=
OFFICE_WEB_IMAGE=
OFFICE_TOOLS_IMAGE=
OFFICE_PULL_POLICY=

# --- PostgreSQL 16 ---------------------------------------------------
# Superuser: used only by the init script, backup and restore. Never by n8n or apps.
POSTGRES_SUPERUSER=postgres_admin
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Owner of the "n8n" database (n8n internal data). Cannot connect to "office".
N8N_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Owner of the "office" database; used only by the migration tool (DDL).
OFFICE_MIGRATOR_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# office_app: SELECT/INSERT/UPDATE/DELETE only. Used by n8n (WhatsApp tables, schema "app").
OFFICE_APP_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# office_readonly: SELECT only. Reports and the panel's read views.
OFFICE_READONLY_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# office_api: the .NET backend. Read/write on schema "hazem" only; no access to the WhatsApp tables.
OFFICE_API_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Redis 7 ---------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Object storage (Garage, S3-compatible) --------------------------
# 64 hex chars. Internal cluster RPC secret.
GARAGE_RPC_SECRET=CHANGE_ME_64_HEX_CHARS
# Bearer token for the Garage admin API (internal network only).
GARAGE_ADMIN_TOKEN=CHANGE_ME_STRONG_TOKEN
# S3 region name Garage answers to.
S3_REGION=garage
# n8n key: read/write on office-media and office-sensitive only.
# Key ID format: GK + 24 hex chars. Secret: 64 hex chars.
S3_N8N_ACCESS_KEY_ID=CHANGE_ME_GK_KEY_ID
S3_N8N_SECRET_ACCESS_KEY=CHANGE_ME_64_HEX_CHARS
# Backup key: read/write/owner on office-backups only.
S3_BACKUP_ACCESS_KEY_ID=CHANGE_ME_GK_KEY_ID
S3_BACKUP_SECRET_ACCESS_KEY=CHANGE_ME_64_HEX_CHARS
# TASK 07c: the api opens client files for the panel (read-only on media and sensitive).
S3_API_ACCESS_KEY_ID=CHANGE_ME_GK_PLUS_24_HEX
S3_API_SECRET_ACCESS_KEY=CHANGE_ME_64_HEX_CHARS
# Where people open the panel (links in alert e-mails). Empty = http://127.0.0.1:8080
PANEL_URL=

# --- n8n -------------------------------------------------------------
# 32+ random bytes (64 hex chars). If it changes or is lost, every stored
# n8n credential becomes unreadable. Back it up somewhere safe.
N8N_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS
# Local defaults. When the tunnel is used, set WEBHOOK_URL to the https URL
# (with trailing slash) and restart n8n.
N8N_HOST=127.0.0.1
N8N_PROTOCOL=http
WEBHOOK_URL=http://127.0.0.1:5678/
# 1 = trust one reverse proxy hop (cloudflared).
N8N_PROXY_HOPS=1
# false only because the local editor is plain http://127.0.0.1. Set true behind HTTPS.
N8N_SECURE_COOKIE=false
# Execution history retention, in hours (336 = 14 days).
EXECUTIONS_DATA_MAX_AGE=168

# --- n8n <-> .NET backend (DECISIONS v1.3, docs/hazem-internal-api.md) ---
# Header X-Hazem-Token. One secret per direction, 64 hex chars each, never the same value.
# n8n -> API (also stored by n8n-import in the n8n credential hazem-api)
HAZEM_API_TOKEN=CHANGE_ME_64_HEX_CHARS
# API -> n8n internal send webhook (also stored in the n8n credential hazem-internal-send)
N8N_INTERNAL_SEND_TOKEN=CHANGE_ME_64_HEX_CHARS

# --- Hazem's intent classification in .NET (TASK 04, DECISIONS T-07/T-08) ---
# The .NET key from OpenAI, separate from n8n's voice key (credential openai-transcription).
# gen-secrets does NOT create it (it comes from your OpenAI account). It MAY stay empty: then
# classification is off and Hazem answers every text turn as "unclear" (healthcheck: WARN).
# Never print it, log it or commit it.
HAZEM_OPENAI_API_KEY=
# Model for classification. Empty = gpt-4.1-mini, a starting point only: choose the final model
# after running classify-eval on docs/ai/eval-set.jsonl (docs/ai/classification.md, T-08).
OPENAI_MODEL=
# Empty = https://api.openai.com/v1. Tests never change it (hazem-e2e uses hazem.settings ai.stub_*).
OPENAI_BASE_URL=
# v1.26: the second classifier, Anthropic (console.anthropic.com → API keys). hazem.settings ai.provider
# (openai | anthropic) picks who answers first; when it fails (no key, no credits, an error) the other
# one answers. MAY stay empty. Never print it, log it or commit it.
HAZEM_ANTHROPIC_API_KEY=
# Empty = claude-opus-5-5. Choose after classify-eval --provider anthropic (docs/ai/classification.md).
ANTHROPIC_MODEL=

# --- The booking: the lawyer's Google Calendar (TASK 08, DECISIONS v1.12 T-14, P2) ---
# The key file of a Google Cloud service account, as ONE line of base64 (docs/runbooks/booking.md
# says how). gen-secrets does NOT create it; the owner puts it here himself. It MAY stay empty:
# then Hazem offers no times (healthcheck: WARN). Never print it, log it or commit it.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Cloudflare tunnel (optional)------------------------------------
# Empty = use the Quick Tunnel profile ("tunnel").
# Set it to use the Named Tunnel profile ("tunnel-named") with a stable hostname.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Future tasks: placeholders only, leave empty for now ------------
# TASK 02 - Meta identifiers (App ID, WABA ID, phone number ID, Graph version, test
# recipients) are NOT here: they live in the database table app.settings
# (docs/whatsapp-integration.md).
# Monitoring (T-16) - the Telegram chat id goes in app.settings (ops.telegram_chat_id).
#
# These secrets are NOT stored in .env. They go into n8n Credentials:
#   meta-whatsapp-token, meta-whatsapp-trigger (App Secret), meta-app-token (TASK 02)
#   openai-transcription: the voice-note key (TASK 03); the .NET key is HAZEM_OPENAI_API_KEY above
#   TELEGRAM_BOT_TOKEN (monitoring)

# --- The panel: sign-up, e-mail codes and the authenticator (DECISIONS v1.9, T-23) ---
# PANEL_SECRET_KEY: 64 hex chars from gen-secrets. It hashes the e-mail codes and encrypts the
# authenticator secrets: if it changes, everyone who turned 2FA on sets it up again.
# Empty = the sign-up page and 2FA say "not available"; signing in still works.
PANEL_SECRET_KEY=
# The authenticator is optional for everyone (v1.16, the owner). true = a manager must turn it on (v1.9).
PANEL_MANAGERS_NEED_2FA=false

# --- TASK 02b: the WAHA test channel (DECISIONS v1.19), a spare number only, until Meta approves ---
# Leave empty unless you use it (docs/runbooks/waha.md). gen-secrets prints all three.
# WAHA_API_KEY: n8n -> WAHA (X-Api-Key). WAHA_WEBHOOK_TOKEN: WAHA -> n8n (X-Waha-Token).
# WAHA_DASHBOARD_PASSWORD: the dashboard on 127.0.0.1:3010 (user "office"), where the QR code is scanned.
WAHA_API_KEY=
WAHA_WEBHOOK_TOKEN=
WAHA_DASHBOARD_PASSWORD=
# The no-reply sender (your own mail provider: Zoho, Resend, Brevo, Google Workspace ...).
# Port 587 with STARTTLS (SMTP_SSL=true); port 465 (implicit TLS) is not supported.
# Never print SMTP_PASSWORD, log it or commit it.
# SendGrid: SMTP_HOST=smtp.sendgrid.net, SMTP_USERNAME=apikey (that word), SMTP_PASSWORD=the API key
# (Mail Send permission only), SMTP_FROM=an address SendGrid verified (Sender or Domain Authentication).
SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
# e.g. no-reply@your-domain
SMTP_FROM=
# Empty = the office's name
SMTP_FROM_NAME=

# --- Chatwoot, the staff's conversations (TASK 07b, DECISIONS T-24) ---
# All from gen-secrets. Chatwoot's database and redis passwords, its Rails secret, and the three
# tokens .NET and Chatwoot use with each other (chatwoot-setup writes the first two into Chatwoot;
# the webhook token is the secret Chatwoot signs its webhook with). Never print them.
CHATWOOT_SECRET_KEY_BASE=CHANGE_ME_128_HEX_CHARS
CHATWOOT_DB_PASSWORD=CHANGE_ME_48_HEX_CHARS
CHATWOOT_REDIS_PASSWORD=CHANGE_ME_48_HEX_CHARS
CHATWOOT_PLATFORM_TOKEN=CHANGE_ME_48_HEX_CHARS
CHATWOOT_BOT_TOKEN=CHANGE_ME_48_HEX_CHARS
CHATWOOT_WEBHOOK_TOKEN=CHANGE_ME_64_HEX_CHARS
# Where people open Chatwoot (the panel links to it). Empty = http://127.0.0.1:3000
CHATWOOT_URL=

# ---- TASK 13: backups ----
# BACKUP_ENCRYPTION_KEY: 64 hex chars from gen-secrets. Every backup (the databases and the client files) is
# encrypted with it. Keep a copy OUTSIDE this machine (a password manager, or on paper in the office's safe):
# without it no backup can ever be read back, by anyone. Never change it without docs/runbooks/secrets.md.
BACKUP_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS
