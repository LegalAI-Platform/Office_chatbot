# Files executed or parsed inside Linux containers must keep LF endings,
# even when the repository is checked out on Windows (core.autocrlf=true).
*.sh            text eol=lf
*.sql           text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.toml          text eol=lf
*.conf          text eol=lf
Dockerfile      text eol=lf
infra/tools/bin/* text eol=lf
.env.example    text eol=lf

# PowerShell scripts use Windows line endings.
*.ps1           text eol=crlf

*.md            text
*.json          text
