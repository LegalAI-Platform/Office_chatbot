<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Keep restored packages next to the repo (gitignored) instead of the user profile. -->
    <add key="globalPackagesFolder" value=".nuget-packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
