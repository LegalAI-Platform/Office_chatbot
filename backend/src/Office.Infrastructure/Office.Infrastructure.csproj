<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Office.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Office.Core\Office.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hosting, options and HttpClient factory; also used by Office.Cli. -->
