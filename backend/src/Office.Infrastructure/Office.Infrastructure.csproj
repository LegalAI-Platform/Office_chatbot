<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Office.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Office.Application\Office.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hosting, options and HttpClient factory; also used by Office.Cli. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The classification prompt (its version is logged with every classification). -->
    <EmbeddedResource Include="Ai\prompts\*.md" />
    <!-- The office seal (the owner's own cut), inside every panel e-mail as an inline image. -->
    <EmbeddedResource Include="Panel\Mail\office-seal.png" LogicalName="Office.Infrastructure.Panel.Mail.office-seal.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- No EF migrations here: dbmate owns the schema (database/migrations, DECISIONS v1.3 T-21). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="Anthropic" />
  </ItemGroup>
</Project>
