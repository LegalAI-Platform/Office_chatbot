<Project>
  <!-- Every version is pinned and was published at least two weeks before it was chosen (2026-10-20). -->
  <ItemGroup>
    <!-- Data -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <!-- Storage (TASK 07c: the api reads client files, read-only). Published 2026-10-08. -->
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104.2" />
    <!-- Host -->
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <!-- AI (v1.26: Anthropic as the second classifier). The official SDK, published 2026-10-14. -->
    <PackageVersion Include="Anthropic" Version="12.57.0" />
    <!-- Monitoring (v1.107): the API's numbers for Prometheus, through OpenTelemetry. Both published 2026-10-20. OpenTelemetry
         still calls its Prometheus exporter "beta" (it follows a draft of the naming spec); it is the one Microsoft's own
         .NET metrics docs use, and it is pinned like everything else. -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.20.1-beta.1" />
    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
  </ItemGroup>
</Project>
